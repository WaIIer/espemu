+static bool esp32_gpio_valid_pin(unsigned pin)
+{
+    return pin < 40 && pin != 20 && pin != 24 && (pin < 28 || pin >= 32);
+}
+
+static uint64_t esp32_gpio_driven(Esp32GpioState *s)
+{
+    uint64_t output = s->gpio_out | ((uint64_t)s->gpio_out1 << 32);
+    uint64_t driven = s->gpio_enable | ((uint64_t)s->gpio_enable1 << 32);
+    for (unsigned pin = 0; pin < MIN(s->num_gpios, ESP_GPIO_MAX_PINS); pin++)
+    {
+        if ((s->pin_config[pin] & 4) && (output & (1ULL << pin)))
+            driven &= ~(1ULL << pin);
+    }
+    return driven;
+}
+
+static uint64_t esp32_gpio_levels(Esp32GpioState *s)
+{
+    uint64_t output = s->gpio_out | ((uint64_t)s->gpio_out1 << 32);
+    uint64_t driven = esp32_gpio_driven(s);
+    uint64_t device = s->device_mask & ~s->external_mask;
+    uint64_t inputs = (s->external_levels & s->external_mask) | (s->device_levels & device) |
+                      (s->gpio_pullup & ~s->external_mask & ~device);
+    return (output & driven) | (inputs & ~driven);
+}
+
+static uint64_t esp32_gpio_interrupts(Esp32GpioState *s, unsigned selector)
+{
+    uint64_t enabled = 0;
+    for (unsigned pin = 0; pin < MIN(s->num_gpios, ESP_GPIO_MAX_PINS); pin++)
+    {
+        if ((s->pin_config[pin] >> 13) & selector)
+            enabled |= 1ULL << pin;
+    }
+    return s->pending & enabled;
+}
+
+static void esp32_gpio_update(Esp32GpioState *s)
+{
+    uint64_t levels = esp32_gpio_levels(s);
+    espemu_max7219_update(s, levels);
+    for (unsigned pin = 0; pin < MIN(s->num_gpios, ESP_GPIO_MAX_PINS); pin++)
+    {
+        uint64_t mask = 1ULL << pin;
+        unsigned type = (s->pin_config[pin] >> 7) & 7;
+        bool current = !!(levels & mask), previous = !!(s->last_levels & mask);
+        if ((type == 1 && !previous && current) || (type == 2 && previous && !current) ||
+            (type == 3 && previous != current) || (type == 4 && !current) || (type == 5 && current))
+            s->pending |= mask;
+    }
+    s->last_levels = levels;
+    qemu_set_irq(s->irq, !!esp32_gpio_interrupts(s, 5));
+}
+
+/* Lets a peripheral model drive an input pin (level 0/1) or release it (-1); edges raise normal GPIO interrupts. */
+void esp32_gpio_drive_input(Esp32GpioState *s, unsigned pin, int level)
+{
+    uint64_t mask = 1ULL << pin;
+    if (pin >= ESP_GPIO_MAX_PINS)
+        return;
+    if (level < 0)
+        s->device_mask &= ~mask;
+    else
+    {
+        s->device_mask |= mask;
+        s->device_levels = level ? s->device_levels | mask : s->device_levels & ~mask;
+    }
+    esp32_gpio_update(s);
+}
