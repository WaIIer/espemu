+static void esp32_gpio_set_inputs(Object *obj, Visitor *visitor, const char *name,
+                                  void *opaque, Error **errp)
+{
+    Esp32GpioState *s = ESP32_GPIO(obj);
+    g_autofree char *text = NULL;
+    if (!visit_type_str(visitor, name, &text, errp))
+        return;
+    if (strlen(text) > 8192)
+    {
+        error_setg(errp, "GPIO input snapshot exceeds limit");
+        return;
+    }
+    QObject *object = qobject_from_json(text, errp);
+    if (!object)
