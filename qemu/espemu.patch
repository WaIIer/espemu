+        {
+            QDict *pin = qobject_to(QDict, qlist_entry_obj(entry));
+            QNum *number = pin ? qobject_to(QNum, qdict_get(pin, "pin")) : NULL;
+            int64_t index;
+            if (!pin || qdict_size(pin) != 2 || !number || !qnum_get_try_int(number, &index) ||
+                index < 0 || !esp32_gpio_valid_pin(index) || (index >= 6 && index <= 11) || (seen & (1ULL << index)))
+            {
+                valid = false;
+                break;
+            }
+            seen |= 1ULL << index;
+            QObject *value = qdict_get(pin, "level");
+            if (qobject_to(QNull, value))
+                continue;
+            QNum *level = qobject_to(QNum, value);
+            int64_t requested;
+            if (!level || !qnum_get_try_int(level, &requested) || requested < 0 || requested > 1)
+            {
+                valid = false;
+                break;
+            }
+            mask |= 1ULL << index;
+            if (requested)
+                levels |= 1ULL << index;
+        }
+    }
+    if (valid)
+    {
+        s->external_mask = mask;
+        s->external_levels = levels;
+        esp32_gpio_update(s);
+    }
+    else
+        error_setg(errp, "GPIO inputs require unique valid non-flash pins and levels 0, 1 or null");
+    qobject_unref(object);
+}
 
+static void esp32_gpio_get_state(Object *obj, Visitor *visitor, const char *name,
+                                 void *opaque, Error **errp)
+{
+    Esp32GpioState *s = ESP32_GPIO(obj);
+    QDict *state = qdict_new();
+    QList *pins = qlist_new();
+    qdict_put_int(state, "v", 1);
+    qdict_put_int(state, "virtualMs", qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL));
+    for (unsigned pin = 0; pin < MIN(s->num_gpios, ESP_GPIO_MAX_PINS); pin++)
+    {
+        if (s->classic && !esp32_gpio_valid_pin(pin))
+            continue;
+        uint32_t mask = 1U << (pin % 32);
+        uint32_t output = pin < 32 ? s->gpio_out : s->gpio_out1;
+        uint32_t enabled = pin < 32 ? s->gpio_enable : s->gpio_enable1;
+        QDict *entry = qdict_new();
+        qdict_put_int(entry, "pin", pin);
+        qdict_put_bool(entry, "outputEnabled", (enabled & mask) != 0);
+        qdict_put_int(entry, "outputLatch", !!(output & mask));
+        qdict_put_int(entry, "level", !!(esp32_gpio_levels(s) & (1ULL << pin)));
+        qdict_put_bool(entry, "externallyDriven", !!(s->external_mask & (1ULL << pin)));
+        qdict_put_bool(entry, "openDrain", !!(s->pin_config[pin] & 4));
+        qdict_put_bool(entry, "pullUp", !!(s->gpio_pullup & (1ULL << pin)));
+        qdict_put_bool(entry, "pullDown", !!(s->gpio_pulldown & (1ULL << pin)));
+        qdict_put_bool(entry, "contended", !!((s->external_levels ^ output) & s->external_mask & esp32_gpio_driven(s) & (1ULL << pin)));
+        qlist_append_obj(pins, QOBJECT(entry));
+    }
+    qdict_put(state, "pins", pins);
+    GString *json = qobject_to_json(QOBJECT(state));
+    char *text = json->str;
+    visit_type_str(visitor, name, &text, errp);
+    g_string_free(json, true);
+    qobject_unref(state);
+}
 
