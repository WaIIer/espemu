diff --git a/hw/sensor/bh1750.c b/hw/sensor/bh1750.c
new file mode 100644
index 0000000..8422006
--- /dev/null
+++ b/hw/sensor/bh1750.c
@@ -0,0 +1,185 @@
+#include "qemu/osdep.h"
+#include "hw/sensor/espemu.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "qapi/qmp/qnum.h"
+
+#define TYPE_BH1750 "espemu-bh1750"
+OBJECT_DECLARE_SIMPLE_TYPE(BH1750State, BH1750)
+
+struct BH1750State
+{
+    I2CSlave parent_obj;
+    QEMUTimer *conversion;
+    int64_t lux_milli;
+    bool connected;
+    bool invalid;
+    bool powered;
+    uint8_t mode;
+    uint8_t mtreg;
+    uint16_t converted;
+    uint16_t read_value;
+    unsigned read_offset;
+};
+
+static int64_t bh1750_period(BH1750State *s)
+{
+    return ((s->mode & 3) == 3 ? 16000 : 120000) * s->mtreg / 69;
+}
+
+static void bh1750_convert(void *opaque)
+{
+    BH1750State *s = opaque;
+    double raw = s->lux_milli * 0.001 * 1.2 * s->mtreg / 69.0;
+    if ((s->mode & 3) == 1)
+    {
+        raw *= 2;
+    }
+    s->converted = (uint16_t)MIN(65535, MAX(0, raw));
+    if ((s->mode & 0xf0) == 0x10 && s->powered)
+    {
+        timer_mod(s->conversion, qemu_clock_get_us(QEMU_CLOCK_VIRTUAL) + bh1750_period(s));
+    }
+    else
+    {
+        s->powered = false;
+    }
+}
+
+static int bh1750_send(I2CSlave *device, uint8_t command)
+{
+    BH1750State *s = BH1750(device);
+    if (command == 0x00)
+    {
+        s->powered = false;
+        timer_del(s->conversion);
+    }
+    else if (command == 0x01)
+    {
+        s->powered = true;
+    }
+    else if (command == 0x07)
+    {
+        if (s->powered)
+        {
+            s->converted = 0;
+        }
+    }
+    else if ((command & 0xf8) == 0x40)
+    {
+        s->mtreg = (s->mtreg & 0x1f) | ((command & 7) << 5);
+    }
+    else if ((command & 0xe0) == 0x60)
+    {
+        uint8_t next = (s->mtreg & 0xe0) | (command & 0x1f);
+        if (next < 31 || next > 254)
+        {
+            return 1;
+        }
+        s->mtreg = next;
+    }
+    else if (command == 0x10 || command == 0x11 || command == 0x13 ||
+             command == 0x20 || command == 0x21 || command == 0x23)
+    {
+        s->mode = command;
+        s->powered = true;
+        timer_mod(s->conversion, qemu_clock_get_us(QEMU_CLOCK_VIRTUAL) + bh1750_period(s));
+    }
+    else
+    {
+        return 1;
+    }
+    return 0;
+}
+
+static int bh1750_event(I2CSlave *device, enum i2c_event event)
+{
+    BH1750State *s = BH1750(device);
+    if (!s->connected && (event == I2C_START_SEND || event == I2C_START_RECV))
+    {
+        return 1;
+    }
+    if (event == I2C_START_RECV)
+    {
+        s->read_offset = 0;
+        s->read_value = s->invalid ? 0xffff : s->converted;
+    }
+    return 0;
+}
+
+static uint8_t bh1750_recv(I2CSlave *device)
+{
+    BH1750State *s = BH1750(device);
+    return s->read_offset++ == 0 ? s->read_value >> 8 : s->read_value & 0xff;
+}
+
+static void bh1750_reset(DeviceState *device)
+{
+    BH1750State *s = BH1750(device);
+    timer_del(s->conversion);
+    s->powered = false;
+    s->mode = 0;
+    s->mtreg = 69;
+    s->converted = 0;
+    s->read_offset = 0;
+}
+
+static void bh1750_init(Object *obj)
+{
+    BH1750State *s = BH1750(obj);
+    s->connected = true;
+    s->lux_milli = 320000;
+    s->conversion = timer_new_us(QEMU_CLOCK_VIRTUAL, bh1750_convert, s);
+    bh1750_reset(DEVICE(s));
+}
+
+static void bh1750_class_init(ObjectClass *klass, void *data)
+{
+    I2CSlaveClass *slave = I2C_SLAVE_CLASS(klass);
+    slave->send = bh1750_send;
+    slave->recv = bh1750_recv;
+    slave->event = bh1750_event;
+    device_class_set_legacy_reset(DEVICE_CLASS(klass), bh1750_reset);
+}
+
+static const TypeInfo bh1750_info = {
+    .name = TYPE_BH1750,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(BH1750State),
+    .instance_init = bh1750_init,
+    .class_init = bh1750_class_init,
+};
+
+static void bh1750_register_types(void)
+{
+    type_register_static(&bh1750_info);
+}
+type_init(bh1750_register_types)
+
+    void espemu_bh1750_input(I2CSlave *device, int64_t lux_milli, bool connected, bool invalid)
+{
+    BH1750State *s = BH1750(device);
+    s->lux_milli = lux_milli;
+    s->connected = connected;
+    s->invalid = invalid;
+}
+
+QDict *espemu_bh1750_state(I2CSlave *device)
+{
+    BH1750State *s = BH1750(device);
+    QDict *result = qdict_new(), *channels = qdict_new();
+    double lux = s->converted / 1.2 * 69.0 / MAX(1, s->mtreg);
+    if ((s->mode & 3) == 1)
+        lux /= 2;
+    qdict_put_str(result, "status", !s->connected ? "disconnected" : s->invalid ? "invalid"
+                                                                 : s->powered   ? "converting"
+                                                                                : "sleep");
+    if (!s->connected || s->invalid)
+        qdict_put_null(channels, "lux");
+    else
+        qdict_put(channels, "lux", qnum_from_double(lux));
+    qdict_put_int(result, "raw", s->converted);
+    qdict_put_int(result, "measurementTime", s->mtreg);
+    qdict_put(result, "channels", channels);
+    return result;
+}
diff --git a/hw/sensor/bme280.c b/hw/sensor/bme280.c
new file mode 100644
index 0000000..3865274
--- /dev/null
+++ b/hw/sensor/bme280.c
@@ -0,0 +1,321 @@
+#include "qemu/osdep.h"
+#include "hw/sensor/espemu.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "qapi/qmp/qnum.h"
+
+#define TYPE_BME280 "espemu-bme280"
+OBJECT_DECLARE_SIMPLE_TYPE(BME280State, BME280)
+
+struct BME280State
+{
+    I2CSlave parent_obj;
+    QEMUTimer *conversion;
+    int64_t temperature_mc;
+    int64_t pressure_pa;
+    int64_t humidity_milli;
+    bool connected;
+    bool invalid;
+    bool expect_pointer;
+    bool measuring;
+    bool loading;
+    uint8_t pointer;
+    uint8_t humidity_os;
+    uint8_t registers[256];
+};
+
+static double bme280_temperature(uint32_t raw, double *fine)
+{
+    double first = (raw / 16384.0 - 27504 / 1024.0) * 26435;
+    double second = raw / 131072.0 - 27504 / 8192.0;
+    second = second * second * -1000;
+    *fine = first + second;
+    return *fine / 5120.0;
+}
+
+static double bme280_pressure(uint32_t raw, double fine)
+{
+    double first = fine / 2.0 - 64000;
+    double second = first * first * -7 / 32768.0;
+    second += first * 140 * 2;
+    second = second / 4.0 + 2855 * 65536.0;
+    first = (3024 * first * first / 524288.0 + -10685 * first) / 524288.0;
+    first = (1 + first / 32768.0) * 36477;
+    double pressure = (1048576.0 - raw - second / 4096.0) * 6250.0 / first;
+    first = 6000 * pressure * pressure / 2147483648.0;
+    second = pressure * -14600 / 32768.0;
+    return pressure + (first + second + 15500) / 16.0;
+}
+
+static double bme280_humidity(uint32_t raw, double fine)
+{
+    double humidity = fine - 76800;
+    humidity = (raw - (334 * 64.0 + 50 / 16384.0 * humidity)) *
+               (362 / 65536.0 * (1 + 30 / 67108864.0 * humidity));
+    humidity *= 1 - 75 * humidity / 524288.0;
+    return MIN(100, MAX(0, humidity));
+}
+
+static void bme280_raw20(BME280State *s, unsigned address, uint32_t raw)
+{
+    s->registers[address] = raw >> 12;
+    s->registers[address + 1] = raw >> 4;
+    s->registers[address + 2] = (raw & 15) << 4;
+}
+
+static void bme280_update_data(BME280State *s)
+{
+    uint32_t lower = 0;
+    uint32_t upper = 1048575;
+    double fine = 0;
+    while (lower < upper)
+    {
+        uint32_t middle = (lower + upper) / 2;
+        if (bme280_temperature(middle, &fine) < s->temperature_mc / 1000.0)
+            lower = middle + 1;
+        else
+            upper = middle;
+    }
+    uint32_t raw_temperature = lower;
+    bme280_temperature(raw_temperature, &fine);
+    fine = (int32_t)fine;
+    lower = 0;
+    upper = 1048575;
+    while (lower < upper)
+    {
+        uint32_t middle = (lower + upper) / 2;
+        if (bme280_pressure(middle, fine) > s->pressure_pa)
+            lower = middle + 1;
+        else
+            upper = middle;
+    }
+    uint32_t raw_pressure = lower;
+    lower = 0;
+    upper = 65535;
+    while (lower < upper)
+    {
+        uint32_t middle = (lower + upper) / 2;
+        if (bme280_humidity(middle, fine) < s->humidity_milli / 1000.0)
+            lower = middle + 1;
+        else
+            upper = middle;
+    }
+    uint32_t raw_humidity = lower;
+    if (s->invalid || !(s->registers[0xf4] >> 5))
+        raw_temperature = 0x80000;
+    if (s->invalid || !((s->registers[0xf4] >> 2) & 7))
+        raw_pressure = 0x80000;
+    if (s->invalid || !s->humidity_os)
+        raw_humidity = 0x8000;
+    bme280_raw20(s, 0xfa, raw_temperature);
+    bme280_raw20(s, 0xf7, raw_pressure);
+    s->registers[0xfd] = raw_humidity >> 8;
+    s->registers[0xfe] = raw_humidity;
+}
+
+static int64_t bme280_conversion_us(BME280State *s)
+{
+    const unsigned oversampling[] = {0, 1, 2, 4, 8, 16, 16, 16};
+    unsigned temperature = oversampling[s->registers[0xf4] >> 5];
+    unsigned pressure = oversampling[(s->registers[0xf4] >> 2) & 7];
+    unsigned humidity = oversampling[s->humidity_os];
+    return 1250 + 2300 * temperature + (pressure ? 2300 * pressure + 575 : 0) +
+           (humidity ? 2300 * humidity + 575 : 0);
+}
+
+static void bme280_start_conversion(BME280State *s)
+{
+    s->measuring = true;
+    s->registers[0xf3] |= 8;
+    timer_mod(s->conversion, qemu_clock_get_us(QEMU_CLOCK_VIRTUAL) + bme280_conversion_us(s));
+}
+
+static void bme280_tick(void *opaque)
+{
+    BME280State *s = opaque;
+    if (s->loading)
+    {
+        s->loading = false;
+        s->registers[0xf3] &= ~1;
+        return;
+    }
+    if (!s->measuring)
+    {
+        bme280_start_conversion(s);
+        return;
+    }
+    bme280_update_data(s);
+    s->measuring = false;
+    s->registers[0xf3] &= ~8;
+    if ((s->registers[0xf4] & 3) == 3)
+    {
+        const int64_t standby[] = {500, 62500, 125000, 250000, 500000, 1000000, 10000, 20000};
+        timer_mod(s->conversion, qemu_clock_get_us(QEMU_CLOCK_VIRTUAL) + standby[s->registers[0xf5] >> 5]);
+    }
+    else
+    {
+        s->registers[0xf4] &= ~3;
+    }
+}
+
+static void bme280_reset(DeviceState *device)
+{
+    BME280State *s = BME280(device);
+    timer_del(s->conversion);
+    memset(s->registers, 0, sizeof(s->registers));
+    const int32_t calibration[] = {27504, 26435, -1000, 36477, -10685, 3024, 2855, 140, -7, 15500, -14600, 6000};
+    for (unsigned index = 0; index < ARRAY_SIZE(calibration); index++)
+    {
+        uint16_t coefficient = calibration[index];
+        s->registers[0x88 + index * 2] = coefficient;
+        s->registers[0x89 + index * 2] = coefficient >> 8;
+    }
+    s->registers[0xa1] = 75;
+    s->registers[0xe1] = 362 & 0xff;
+    s->registers[0xe2] = 362 >> 8;
+    s->registers[0xe3] = 0;
+    s->registers[0xe4] = 334 >> 4;
+    s->registers[0xe5] = ((50 & 15) << 4) | (334 & 15);
+    s->registers[0xe6] = 50 >> 4;
+    s->registers[0xe7] = 30;
+    s->registers[0xd0] = 0x60;
+    bme280_raw20(s, 0xf7, 0x80000);
+    bme280_raw20(s, 0xfa, 0x80000);
+    s->registers[0xfd] = 0x80;
+    s->pointer = 0;
+    s->humidity_os = 0;
+    s->measuring = false;
+    s->loading = true;
+    s->registers[0xf3] = 1;
+    timer_mod(s->conversion, qemu_clock_get_us(QEMU_CLOCK_VIRTUAL) + 2000);
+}
+
+static int bme280_send(I2CSlave *device, uint8_t byte)
+{
+    BME280State *s = BME280(device);
+    if (s->expect_pointer)
+    {
+        s->pointer = byte;
+        s->expect_pointer = false;
+        return 0;
+    }
+    uint8_t address = s->pointer++;
+    if (address == 0xe0 && byte == 0xb6)
+    {
+        bme280_reset(DEVICE(s));
+    }
+    else if (address == 0xf2)
+    {
+        s->registers[address] = byte & 7;
+    }
+    else if (address == 0xf5)
+    {
+        s->registers[address] = byte & 0xfc;
+    }
+    else if (address == 0xf4)
+    {
+        s->registers[address] = byte;
+        s->humidity_os = s->registers[0xf2] & 7;
+        timer_del(s->conversion);
+        if (byte & 3)
+            bme280_start_conversion(s);
+        else
+        {
+            s->measuring = false;
+            s->registers[0xf3] &= ~8;
+        }
+    }
+    return 0;
+}
+
+static uint8_t bme280_recv(I2CSlave *device)
+{
+    BME280State *s = BME280(device);
+    return s->registers[s->pointer++];
+}
+
+static int bme280_event(I2CSlave *device, enum i2c_event event)
+{
+    BME280State *s = BME280(device);
+    if (!s->connected && (event == I2C_START_RECV || event == I2C_START_SEND))
+        return 1;
+    if (event == I2C_START_SEND)
+        s->expect_pointer = true;
+    return 0;
+}
+
+static void bme280_init(Object *obj)
+{
+    BME280State *s = BME280(obj);
+    s->connected = true;
+    s->temperature_mc = 23000;
+    s->pressure_pa = 101325;
+    s->humidity_milli = 45000;
+    s->conversion = timer_new_us(QEMU_CLOCK_VIRTUAL, bme280_tick, s);
+    bme280_reset(DEVICE(s));
+}
+
+static void bme280_class_init(ObjectClass *klass, void *data)
+{
+    I2CSlaveClass *slave = I2C_SLAVE_CLASS(klass);
+    slave->send = bme280_send;
+    slave->recv = bme280_recv;
+    slave->event = bme280_event;
+    device_class_set_legacy_reset(DEVICE_CLASS(klass), bme280_reset);
+}
+
+static const TypeInfo bme280_info = {
+    .name = TYPE_BME280,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(BME280State),
+    .instance_init = bme280_init,
+    .class_init = bme280_class_init,
+};
+
+static void bme280_register_types(void)
+{
+    type_register_static(&bme280_info);
+}
+type_init(bme280_register_types)
+
+    void espemu_bme280_input(I2CSlave *device, int64_t temperature_mc,
+                             int64_t pressure_pa, int64_t humidity_milli,
+                             bool connected, bool invalid)
+{
+    BME280State *s = BME280(device);
+    s->temperature_mc = temperature_mc;
+    s->pressure_pa = pressure_pa;
+    s->humidity_milli = humidity_milli;
+    s->connected = connected;
+    s->invalid = invalid;
+}
+
+QDict *espemu_bme280_state(I2CSlave *device)
+{
+    BME280State *s = BME280(device);
+    QDict *result = qdict_new(), *channels = qdict_new();
+    uint32_t temperature = ((uint32_t)s->registers[0xfa] << 12) | (s->registers[0xfb] << 4) | (s->registers[0xfc] >> 4);
+    uint32_t pressure = ((uint32_t)s->registers[0xf7] << 12) | (s->registers[0xf8] << 4) | (s->registers[0xf9] >> 4);
+    uint32_t humidity = (s->registers[0xfd] << 8) | s->registers[0xfe];
+    double fine = 0;
+    double degrees = bme280_temperature(temperature, &fine);
+    qdict_put_str(result, "status", !s->connected ? "disconnected" : s->invalid ? "invalid"
+                                                                 : s->loading   ? "loading"
+                                                                 : s->measuring ? "converting"
+                                                                                : "ready");
+    if (!s->connected || s->invalid || temperature == 0x80000)
+        qdict_put_null(channels, "temperatureC");
+    else
+        qdict_put(channels, "temperatureC", qnum_from_double(degrees));
+    if (!s->connected || s->invalid || pressure == 0x80000 || temperature == 0x80000)
+        qdict_put_null(channels, "pressurePa");
+    else
+        qdict_put(channels, "pressurePa", qnum_from_double(bme280_pressure(pressure, (int32_t)fine)));
+    if (!s->connected || s->invalid || humidity == 0x8000 || temperature == 0x80000)
+        qdict_put_null(channels, "humidityPct");
+    else
+        qdict_put(channels, "humidityPct", qnum_from_double(bme280_humidity(humidity, (int32_t)fine)));
+    qdict_put_int(result, "chipId", s->registers[0xd0]);
+    qdict_put(result, "channels", channels);
+    return result;
+}
diff --git a/hw/sensor/espemu.c b/hw/sensor/espemu.c
new file mode 100644
index 0000000..d260f74
--- /dev/null
+++ b/hw/sensor/espemu.c
@@ -0,0 +1,485 @@
+#include "qemu/osdep.h"
+#include "hw/sensor/espemu.h"
+#include "hw/sensor/tmp105.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qapi/qmp/qdict.h"
+#include "qapi/qmp/qnum.h"
+#include "qapi/qmp/qbool.h"
+#include "qapi/qmp/qjson.h"
+#include "qapi/qmp/qlist.h"
+#include "qemu/error-report.h"
+#include "qemu/cutils.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+
+#define TYPE_ESPEMU_HUB "espemu-hub"
+OBJECT_DECLARE_SIMPLE_TYPE(EspEmuHub, ESPEMU_HUB)
+
+typedef struct SensorInput
+{
+    int64_t temperature;
+    int64_t lux;
+    int64_t pressure;
+    int64_t humidity;
+    int64_t gyro[3];
+    int64_t accel[3];
+    bool connected;
+    bool invalid;
+} SensorInput;
+
+struct EspEmuHub
+{
+    DeviceState parent_obj;
+    I2CSlave *tmp105;
+    I2CSlave *bh1750;
+    I2CSlave *bme280;
+    SensorInput inputs[3];
+    unsigned count;
+    struct
+    {
+        char id[51];
+        unsigned type;
+        unsigned address;
+        I2CSlave *slave;
+        SensorInput input;
+    } devices[32];
+};
+
+static void espemu_apply_instance(EspEmuHub *s, unsigned index)
+{
+    I2CSlave *device = s->devices[index].slave;
+    SensorInput *input = &s->devices[index].input;
+    switch (s->devices[index].type)
+    {
+    case 0:
+        object_property_set_int(OBJECT(device), "temperature", input->temperature, &error_abort);
+        object_property_set_bool(OBJECT(device), "connected", input->connected, &error_abort);
+        object_property_set_bool(OBJECT(device), "invalid", input->invalid, &error_abort);
+        break;
+    case 1:
+        espemu_bh1750_input(device, input->lux, input->connected, input->invalid);
+        break;
+    case 2:
+        espemu_bme280_input(device, input->temperature, input->pressure, input->humidity, input->connected, input->invalid);
+        break;
+    case 3:
+        espemu_mpu6050_input(device, input->gyro, input->accel, input->temperature, input->connected, input->invalid);
+        break;
+    case 4:
+        espemu_sht3x_input(device, input->temperature, input->humidity, input->connected, input->invalid);
+        break;
+    case 5:
+        espemu_hd44780_input(device, input->connected);
+        break;
+    }
+}
+
+static bool espemu_integer(QDict *dict, const char *name, int64_t minimum,
+                           int64_t maximum, int64_t *result, Error **errp)
+{
+    QNum *number = qobject_to(QNum, qdict_get(dict, name));
+    if (!number || !qnum_get_try_int(number, result) ||
+        *result < minimum || *result > maximum)
+    {
+        error_setg(errp, "%s must be an integer in [ %" PRId64 ", %" PRId64 " ]",
+                   name, minimum, maximum);
+        return false;
+    }
+    return true;
+}
+
+static bool espemu_parse_sensor(QDict *dict, int index, SensorInput *input,
+                                Error **errp)
+{
+    if (!dict || qdict_size(dict) != (index == 3 ? 9 : index == 2 ? 5 : index == 4 ? 4 : index == 5 ? 2
+                                                                  : 3) ||
+        !qobject_to(QBool, qdict_get(dict, "connected")) ||
+        !qobject_to(QBool, qdict_get(dict, "invalid")))
+    {
+        error_setg(errp, "Invalid sensor snapshot or unknown fields");
+        return false;
+    }
+    input->connected = qdict_get_bool(dict, "connected");
+    input->invalid = qdict_get_bool(dict, "invalid");
+    if (index == 5)
+        return true; /* output-only display: only bus connection is a physical input */
+    if (index == 1)
+    {
+        return espemu_integer(dict, "luxMilli", 0, 54000000, &input->lux, errp);
+    }
+    if (!espemu_integer(dict, "temperatureMc", index == 0 ? -55000 : -40000,
+                        index == 0 || index == 4 ? 125000 : 85000, &input->temperature, errp))
+    {
+        return false;
+    }
+    if (index == 4)
+    {
+        return espemu_integer(dict, "humidityMilli", 0, 100000, &input->humidity, errp);
+    }
+    if (index == 3)
+    {
+        static const char *gyro[] = {"gyroXmilliDps", "gyroYmilliDps", "gyroZmilliDps"};
+        static const char *accel[] = {"accelXmilliG", "accelYmilliG", "accelZmilliG"};
+        for (unsigned axis = 0; axis < 3; axis++)
+        {
+            if (!espemu_integer(dict, gyro[axis], -2000000, 2000000, &input->gyro[axis], errp) ||
+                !espemu_integer(dict, accel[axis], -16000, 16000, &input->accel[axis], errp))
+            {
+                return false;
+            }
+        }
+        return true;
+    }
+    return index == 0 ||
+           (espemu_integer(dict, "pressurePa", 30000, 110000, &input->pressure, errp) &&
+            espemu_integer(dict, "humidityMilli", 0, 100000, &input->humidity, errp));
+}
+
+static QDict *espemu_inputs_object(EspEmuHub *s)
+{
+    QDict *result = qdict_new();
+    const char *names[] = {"tmp105", "bh1750", "bme280"};
+    qdict_put_int(result, "v", 1);
+    for (int index = 0; index < 3; index++)
+    {
+        SensorInput *input = &s->inputs[index];
+        QDict *device = qdict_new();
+        qdict_put_bool(device, "connected", input->connected);
+        qdict_put_bool(device, "invalid", input->invalid);
+        if (index == 1)
+        {
+            qdict_put_int(device, "luxMilli", input->lux);
+        }
+        else
+        {
+            qdict_put_int(device, "temperatureMc", input->temperature);
+        }
+        if (index == 2)
+        {
+            qdict_put_int(device, "pressurePa", input->pressure);
+            qdict_put_int(device, "humidityMilli", input->humidity);
+        }
+        qdict_put(result, names[index], device);
+    }
+    return result;
+}
+
+static void espemu_get_inputs(Object *obj, Visitor *visitor, const char *name,
+                              void *opaque, Error **errp)
+{
+    EspEmuHub *s = ESPEMU_HUB(obj);
+    QDict *result = espemu_inputs_object(s);
+    GString *json = qobject_to_json(QOBJECT(result));
+    char *text = json->str;
+    visit_type_str(visitor, name, &text, errp);
+    g_string_free(json, true);
+    qobject_unref(result);
+}
+
+static void espemu_set_inputs(Object *obj, Visitor *visitor, const char *name,
+                              void *opaque, Error **errp)
+{
+    EspEmuHub *s = ESPEMU_HUB(obj);
+    g_autofree char *text = NULL;
+    if (!visit_type_str(visitor, name, &text, errp))
+    {
+        return;
+    }
+    if (strlen(text) > 4096)
+    {
+        error_setg(errp, "Input snapshot exceeds 4096 bytes");
+        return;
+    }
+    QObject *object = qobject_from_json(text, errp);
+    if (!object)
+    {
+        return;
+    }
+    QDict *dict = qobject_to(QDict, object);
+    SensorInput next[3] = {0};
+    int64_t version;
+    bool valid = dict && qdict_size(dict) == 4;
+    if (!valid)
+    {
+        error_setg(errp, "Input snapshot must have exactly v and three sensors");
+    }
+    else
+    {
+        valid = espemu_integer(dict, "v", 1, 1, &version, errp) &&
+                espemu_parse_sensor(qobject_to(QDict, qdict_get(dict, "tmp105")), 0, &next[0], errp) &&
+                espemu_parse_sensor(qobject_to(QDict, qdict_get(dict, "bh1750")), 1, &next[1], errp) &&
+                espemu_parse_sensor(qobject_to(QDict, qdict_get(dict, "bme280")), 2, &next[2], errp);
+    }
+    if (valid)
+    {
+        memcpy(s->inputs, next, sizeof(next));
+        if (s->tmp105)
+            object_property_set_int(OBJECT(s->tmp105), "temperature", next[0].temperature, &error_abort);
+        if (s->tmp105)
+            object_property_set_bool(OBJECT(s->tmp105), "connected", next[0].connected, &error_abort);
+        if (s->tmp105)
+            object_property_set_bool(OBJECT(s->tmp105), "invalid", next[0].invalid, &error_abort);
+        if (s->bh1750)
+            espemu_bh1750_input(s->bh1750, next[1].lux, next[1].connected, next[1].invalid);
+        if (s->bme280)
+            espemu_bme280_input(s->bme280, next[2].temperature, next[2].pressure,
+                                next[2].humidity, next[2].connected, next[2].invalid);
+    }
+    qobject_unref(object);
+}
+
+static void espemu_get_state(Object *obj, Visitor *visitor, const char *name,
+                             void *opaque, Error **errp)
+{
+    QDict *result = qdict_new();
+    qdict_put_int(result, "v", 1);
+    qdict_put_int(result, "virtualMs", qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL));
+    qdict_put(result, "inputs", espemu_inputs_object(ESPEMU_HUB(obj)));
+    GString *json = qobject_to_json(QOBJECT(result));
+    char *text = json->str;
+    visit_type_str(visitor, name, &text, errp);
+    g_string_free(json, true);
+    qobject_unref(result);
+}
+
+static QDict *espemu_instance_input(SensorInput *input, unsigned type)
+{
+    QDict *result = qdict_new();
+    qdict_put_bool(result, "connected", input->connected);
+    qdict_put_bool(result, "invalid", input->invalid);
+    if (type == 1)
+        qdict_put_int(result, "luxMilli", input->lux);
+    else if (type != 5)
+        qdict_put_int(result, "temperatureMc", input->temperature);
+    if (type == 2)
+        qdict_put_int(result, "pressurePa", input->pressure);
+    if (type == 2 || type == 4)
+        qdict_put_int(result, "humidityMilli", input->humidity);
+    if (type == 3)
+    {
+        static const char *gyro[] = {"gyroXmilliDps", "gyroYmilliDps", "gyroZmilliDps"};
+        static const char *accel[] = {"accelXmilliG", "accelYmilliG", "accelZmilliG"};
+        for (unsigned axis = 0; axis < 3; axis++)
+        {
+            qdict_put_int(result, gyro[axis], input->gyro[axis]);
+            qdict_put_int(result, accel[axis], input->accel[axis]);
+        }
+    }
+    return result;
+}
+
+static void espemu_get_circuit(Object *obj, Visitor *visitor, const char *name,
+                               void *opaque, Error **errp)
+{
+    EspEmuHub *s = ESPEMU_HUB(obj);
+    const char *types[] = {"tmp105", "bh1750", "bme280", "mpu6050", "sht3x", "hd44780"};
+    QDict *result = qdict_new();
+    QList *devices = qlist_new();
+    qdict_put_int(result, "v", 1);
+    qdict_put_int(result, "virtualMs", qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL));
+    for (unsigned index = 0; index < s->count; index++)
+    {
+        QDict *device = qdict_new();
+        qdict_put_str(device, "id", s->devices[index].id);
+        qdict_put_str(device, "type", types[s->devices[index].type]);
+        qdict_put_int(device, "address", s->devices[index].address);
+        qdict_put(device, "inputs", espemu_instance_input(&s->devices[index].input, s->devices[index].type));
+        QDict *state;
+        if (s->devices[index].type == 0)
+        {
+            TMP105State *sensor = TMP105(s->devices[index].slave);
+            state = qdict_new();
+            QDict *channels = qdict_new();
+            qdict_put_str(state, "status", !sensor->connected ? "disconnected" : sensor->invalid    ? "invalid"
+                                                                             : (sensor->config & 1) ? "sleep"
+                                                                                                    : "converting");
+            if (!sensor->connected || sensor->invalid)
+                qdict_put_null(channels, "temperatureC");
+            else
+            {
+                uint8_t mask = 0xf0 << ((~sensor->config >> 5) & 3);
+                int16_t raw = ((uint16_t)sensor->temperature & 0xff00) | ((uint8_t)sensor->temperature & mask);
+                qdict_put(channels, "temperatureC", qnum_from_double(raw / 256.0));
+            }
+            qdict_put_int(state, "config", sensor->config);
+            qdict_put(state, "channels", channels);
+        }
+        else if (s->devices[index].type == 1)
+            state = espemu_bh1750_state(s->devices[index].slave);
+        else if (s->devices[index].type == 2)
+            state = espemu_bme280_state(s->devices[index].slave);
+        else if (s->devices[index].type == 3)
+            state = espemu_mpu6050_state(s->devices[index].slave);
+        else if (s->devices[index].type == 4)
+            state = espemu_sht3x_state(s->devices[index].slave);
+        else
+            state = espemu_hd44780_state(s->devices[index].slave);
+        qdict_put(device, "state", state);
+        qlist_append_obj(devices, QOBJECT(device));
+    }
+    qdict_put(result, "devices", devices);
+    GString *json = qobject_to_json(QOBJECT(result));
+    char *text = json->str;
+    visit_type_str(visitor, name, &text, errp);
+    g_string_free(json, true);
+    qobject_unref(result);
+}
+
+static void espemu_set_circuit_inputs(Object *obj, Visitor *visitor, const char *name,
+                                      void *opaque, Error **errp)
+{
+    EspEmuHub *s = ESPEMU_HUB(obj);
+    g_autofree char *text = NULL;
+    if (!visit_type_str(visitor, name, &text, errp))
+        return;
+    if (strlen(text) > 32768)
+    {
+        error_setg(errp, "Circuit inputs exceed 32KiB");
+        return;
+    }
+    QObject *object = qobject_from_json(text, errp);
+    if (!object)
+        return;
+    QDict *dict = qobject_to(QDict, object);
+    QDict *devices = dict ? qobject_to(QDict, qdict_get(dict, "devices")) : NULL;
+    int64_t version;
+    SensorInput next[32] = {0};
+    bool valid = dict && qdict_size(dict) == 2 && devices && qdict_size(devices) == s->count;
+    if (valid)
+        valid = espemu_integer(dict, "v", 1, 1, &version, errp);
+    for (unsigned index = 0; valid && index < s->count; index++)
+        valid = espemu_parse_sensor(qobject_to(QDict, qdict_get(devices, s->devices[index].id)), s->devices[index].type, &next[index], errp);
+    if (valid)
+    {
+        for (unsigned index = 0; index < s->count; index++)
+        {
+            s->devices[index].input = next[index];
+            espemu_apply_instance(s, index);
+        }
+    }
+    else if (!errp || !*errp)
+        error_setg(errp, "Circuit inputs must match configured device ids exactly");
+    qobject_unref(object);
+}
+
+static void espemu_hub_init(Object *obj)
+{
+    EspEmuHub *s = ESPEMU_HUB(obj);
+    s->inputs[0] = (SensorInput){.temperature = 25000, .connected = true};
+    s->inputs[1] = (SensorInput){.lux = 320000, .connected = true};
+    s->inputs[2] = (SensorInput){.temperature = 23000, .pressure = 101325, .humidity = 45000, .connected = true};
+    object_property_add(obj, "inputs", "str", espemu_get_inputs, espemu_set_inputs, NULL, NULL);
+    object_property_add(obj, "state", "str", espemu_get_state, NULL, NULL, NULL);
+    object_property_add(obj, "circuit-state", "str", espemu_get_circuit, NULL, NULL, NULL);
+    object_property_add(obj, "circuit-inputs", "str", NULL, espemu_set_circuit_inputs, NULL, NULL);
+}
+
+static void espemu_hub_class_init(ObjectClass *klass, void *data)
+{
+    DEVICE_CLASS(klass)->user_creatable = false;
+}
+
+static const TypeInfo espemu_hub_info = {
+    .name = TYPE_ESPEMU_HUB,
+    .parent = TYPE_DEVICE,
+    .instance_size = sizeof(EspEmuHub),
+    .instance_init = espemu_hub_init,
+    .class_init = espemu_hub_class_init,
+};
+
+static void espemu_register_types(void)
+{
+    type_register_static(&espemu_hub_info);
+}
+type_init(espemu_register_types)
+
+    void espemu_attach(Object *soc, I2CBus *bus)
+{
+    DeviceState *device = qdev_new(TYPE_ESPEMU_HUB);
+    EspEmuHub *hub = ESPEMU_HUB(device);
+    object_property_add_child(soc, "espemu", OBJECT(device));
+    const char *filename = g_getenv("ESPEMU_QEMU_CIRCUIT");
+    if (filename && *filename)
+    {
+        g_autofree char *text = NULL;
+        gsize length;
+        GError *file_error = NULL;
+        if (!g_file_get_contents(filename, &text, &length, &file_error))
+        {
+            error_report("Cannot read circuit: %s", file_error->message);
+            exit(1);
+        }
+        if (length > 65536)
+        {
+            error_report("Circuit exceeds 64KiB");
+            exit(1);
+        }
+        QObject *object = qobject_from_json(text, &error_fatal);
+        QDict *dict = qobject_to(QDict, object);
+        QList *devices = dict ? qobject_to(QList, qdict_get(dict, "devices")) : NULL;
+        int64_t version;
+        /* An optional "camera" entry is read by espemu_camera_attach. */
+        if (!dict || qdict_size(dict) != 2u + qdict_haskey(dict, "camera") + qdict_haskey(dict, "speaker") || !devices || !espemu_integer(dict, "v", 1, 1, &version, &error_fatal))
+        {
+            error_report("Circuit must contain v:1 and devices");
+            exit(1);
+        }
+        bool addresses[128] = {0};
+        const char *types[] = {"tmp105", "bh1750", "bme280", "mpu6050", "sht3x", "hd44780"};
+        const char *models[] = {"tmp105", "espemu-bh1750", "espemu-bme280", "espemu-mpu6050", "espemu-sht3x", "espemu-hd44780"};
+        const QListEntry *entry;
+        QLIST_FOREACH_ENTRY(devices, entry)
+        {
+            QDict *config = qobject_to(QDict, qlist_entry_obj(entry));
+            const char *id = config ? qdict_get_try_str(config, "id") : NULL;
+            const char *type = config ? qdict_get_try_str(config, "type") : NULL;
+            int64_t address;
+            unsigned selected = 6;
+            for (unsigned index = 0; type && index < 6; index++)
+                if (!strcmp(type, types[index]))
+                    selected = index;
+            if (!config || qdict_size(config) != 4 || !id || !*id || strlen(id) > 50 || selected == 6 || hub->count == 32 ||
+                !espemu_integer(config, "address", 1, 127, &address, &error_fatal))
+            {
+                error_report("Invalid circuit device");
+                exit(1);
+            }
+            if (addresses[address] || (selected == 0 && (address < 0x48 || address > 0x4f)) ||
+                (selected == 1 && address != 0x23 && address != 0x5c) || (selected == 2 && address != 0x76 && address != 0x77) ||
+                (selected == 3 && address != 0x68 && address != 0x69) || (selected == 4 && address != 0x44 && address != 0x45) ||
+                (selected == 5 && !(address >= 0x20 && address <= 0x27) && !(address >= 0x38 && address <= 0x3f)))
+            {
+                error_report("Unsupported or conflicting %s address 0x%02x", type, (unsigned)address);
+                exit(1);
+            }
+            for (unsigned index = 0; index < hub->count; index++)
+                if (!strcmp(id, hub->devices[index].id))
+                {
+                    error_report("Duplicate circuit id %s", id);
+                    exit(1);
+                }
+            unsigned index = hub->count++;
+            addresses[address] = true;
+            pstrcpy(hub->devices[index].id, sizeof(hub->devices[index].id), id);
+            hub->devices[index].type = selected;
+            hub->devices[index].address = address;
+            if (!espemu_parse_sensor(qobject_to(QDict, qdict_get(config, "inputs")), selected, &hub->devices[index].input, &error_fatal))
+                exit(1);
+            hub->devices[index].slave = i2c_slave_create_simple(bus, models[selected], address);
+            espemu_apply_instance(hub, index);
+            if (selected == 0)
+                hub->tmp105 = hub->devices[index].slave;
+            if (selected == 1)
+                hub->bh1750 = hub->devices[index].slave;
+            if (selected == 2)
+                hub->bme280 = hub->devices[index].slave;
+        }
+        qobject_unref(object);
+    }
+    qdev_realize_and_unref(device, NULL, &error_fatal);
+    object_property_add_alias(soc, "espemu-inputs", OBJECT(device), "inputs");
+    object_property_add_alias(soc, "espemu-state", OBJECT(device), "state");
+    object_property_add_alias(soc, "espemu-circuit", OBJECT(device), "circuit-state");
+    object_property_add_alias(soc, "espemu-circuit-inputs", OBJECT(device), "circuit-inputs");
+}
diff --git a/hw/sensor/espemu_ov2640.c b/hw/sensor/espemu_ov2640.c
new file mode 100644
index 0000000..5694b19
--- /dev/null
+++ b/hw/sensor/espemu_ov2640.c
@@ -0,0 +1,451 @@
+/*
+ * OmniVision OV2640 camera sensor for ESPEmu: SCCB register banks plus a DVP frame source.
+ * Register facts follow the OV2640 register map used by espressif/esp32-camera (ov2640_regs.h):
+ * bank select 0xFF, PID/VER/MIDH/MIDL 0x0A/0x0B/0x1C/0x1D in the sensor bank, COM7 soft reset,
+ * DSP IMAGE_MODE 0xDA (JPEG/RGB565/YUV422) and output size ZMOW/ZMOH/ZMHH (in units of 4 pixels).
+ * Image content comes from host-supplied frames already encoded in the selected output format;
+ * the model does not implement the ISP, scaling, exposure or JPEG encoding.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "hw/sensor/espemu.h"
+#include "hw/misc/esp32_i2s.h"
+#include "hw/gpio/esp32_gpio.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "qemu/error-report.h"
+#include "qemu/cutils.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qapi/qmp/qdict.h"
+#include "qapi/qmp/qjson.h"
+#include "qapi/qmp/qnum.h"
+#include "qapi/qmp/qstring.h"
+
+#define TYPE_ESPEMU_OV2640 "espemu-ov2640"
+OBJECT_DECLARE_SIMPLE_TYPE(EspemuOv2640, ESPEMU_OV2640)
+
+#define OV2640_MAX_FRAME (512 * 1024)
+#define OV2640_FRAME_PERIOD_US 100000  /* 10 frames per second */
+#define OV2640_VSYNC_PULSE_US 1000
+#define OV2640_TICK_US 1000
+#define OV2640_BYTES_PER_TICK 2048     /* 2 MB/s: near esp32-camera raw-mode PCLK, slow enough for an emulated CPU to drain DMA */
+#define OV2640_START_WAIT_US 20000
+#define OV2640_EOF_POLL_US 50
+
+enum { FORMAT_NONE, FORMAT_JPEG, FORMAT_RGB565, FORMAT_YUV422 };
+static const char *const format_names[] = {"none", "jpeg", "rgb565", "yuv422"};
+enum { PHASE_IDLE, PHASE_VSYNC, PHASE_WAIT, PHASE_STREAM, PHASE_BLANK };
+
+struct EspemuOv2640
+{
+    I2CSlave parent_obj;
+    Esp32GpioState *gpio;
+    Esp32I2SState *i2s;
+    QEMUTimer *timer;
+    bool configured;
+    char id[51];
+    unsigned vsync;
+    uint8_t regs[2][256];
+    uint8_t address;
+    unsigned write_count;
+    unsigned phase;
+    int64_t frame_start_us;
+    int64_t phase_start_us;
+    size_t streamed;
+    uint8_t *frame;          /* latest source picture; may be replaced at any time */
+    size_t frame_length;
+    uint8_t *streaming;      /* private copy latched at VSYNC so replacement never tears a frame */
+    size_t streaming_length;
+    unsigned frame_format;
+    unsigned frame_width;
+    unsigned frame_height;
+    uint64_t frame_seq;
+    uint64_t frames_started;
+    uint64_t frames_delivered;
+    uint64_t frames_missed;
+    char error[160];
+};
+
+static uint8_t *bank_regs(EspemuOv2640 *s) { return s->regs[s->regs[0][0xff] & 1]; }
+
+static void ov2640_sensor_defaults(EspemuOv2640 *s)
+{
+    uint8_t bank = s->regs[0][0xff];
+    memset(s->regs[1], 0, sizeof(s->regs[1]));
+    s->regs[1][0x0a] = 0x26; /* PID */
+    s->regs[1][0x0b] = 0x42; /* VER */
+    s->regs[1][0x1c] = 0x7f; /* MIDH */
+    s->regs[1][0x1d] = 0xa2; /* MIDL */
+    s->regs[0][0xff] = s->regs[1][0xff] = bank;
+}
+
+static void ov2640_defaults(EspemuOv2640 *s)
+{
+    memset(s->regs, 0, sizeof(s->regs));
+    s->regs[0][0xff] = s->regs[1][0xff] = 1;
+    ov2640_sensor_defaults(s);
+}
+
+static unsigned sensor_format(EspemuOv2640 *s)
+{
+    uint8_t mode = s->regs[0][0xda];
+    if (mode & 0x10)
+        return FORMAT_JPEG;
+    switch ((mode >> 2) & 3)
+    {
+    case 0: return FORMAT_YUV422;
+    case 2: return FORMAT_RGB565;
+    default: return FORMAT_NONE; /* RAW10 is outside the emulated subset */
+    }
+}
+
+static unsigned sensor_width(EspemuOv2640 *s) { return (s->regs[0][0x5a] | ((s->regs[0][0x5c] & 3) << 8)) * 4; }
+static unsigned sensor_height(EspemuOv2640 *s) { return (s->regs[0][0x5b] | (((s->regs[0][0x5c] >> 2) & 1) << 8)) * 4; }
+
+static bool frame_matches(EspemuOv2640 *s)
+{
+    return s->frame && s->frame_format == sensor_format(s) && s->frame_width == sensor_width(s) && s->frame_height == sensor_height(s);
+}
+
+static void ov2640_schedule(EspemuOv2640 *s, int64_t at_us)
+{
+    timer_mod(s->timer, at_us);
+}
+
+static void ov2640_tick(void *opaque)
+{
+    EspemuOv2640 *s = opaque;
+    int64_t now = qemu_clock_get_us(QEMU_CLOCK_VIRTUAL);
+    switch (s->phase)
+    {
+    case PHASE_IDLE:
+    case PHASE_BLANK:
+        if (!frame_matches(s))
+        {
+            /* No usable image: hold VSYNC low and produce no frames, like a sensor with no output. */
+            esp32_gpio_drive_input(s->gpio, s->vsync, 0);
+            s->phase = PHASE_IDLE;
+            ov2640_schedule(s, now + OV2640_FRAME_PERIOD_US);
+            return;
+        }
+        esp32_gpio_drive_input(s->gpio, s->vsync, 1);
+        s->phase = PHASE_VSYNC;
+        s->frame_start_us = now;
+        ov2640_schedule(s, now + OV2640_VSYNC_PULSE_US);
+        return;
+    case PHASE_VSYNC:
+        /* Falling VSYNC ends the previous frame and starts this one (esp32-camera triggers on it). */
+        esp32_gpio_drive_input(s->gpio, s->vsync, 0);
+        if (!frame_matches(s))
+        {
+            /* The source was cleared or changed size during the pulse: output nothing this period. */
+            s->phase = PHASE_IDLE;
+            ov2640_schedule(s, s->frame_start_us + OV2640_FRAME_PERIOD_US);
+            return;
+        }
+        g_free(s->streaming);
+        s->streaming = g_memdup2(s->frame, s->frame_length);
+        s->streaming_length = s->frame_length;
+        esp32_i2s_camera_frame_start(s->i2s);
+        s->frames_started++;
+        s->streamed = 0;
+        s->phase = PHASE_WAIT;
+        s->phase_start_us = now;
+        ov2640_schedule(s, now + OV2640_TICK_US);
+        return;
+    case PHASE_WAIT:
+        /* Vertical blanking is stretched until the driver starts DMA, so host scheduling jitter does not drop frames. */
+        if (esp32_i2s_camera_receiving(s->i2s))
+        {
+            s->phase = PHASE_STREAM;
+            s->phase_start_us = now;
+        }
+        else if (now - s->phase_start_us >= OV2640_START_WAIT_US)
+        {
+            s->frames_missed++;
+            s->phase = PHASE_BLANK;
+            ov2640_schedule(s, MAX(now + OV2640_TICK_US, s->frame_start_us + OV2640_FRAME_PERIOD_US));
+            return;
+        }
+        ov2640_schedule(s, now + OV2640_TICK_US);
+        return;
+    case PHASE_STREAM:
+    {
+        if (esp32_i2s_eof_pending(s->i2s) && now - s->phase_start_us < OV2640_START_WAIT_US)
+        {
+            /* Stretch pixel timing until the guest has serviced the previous EOF, independent of host jitter. */
+            ov2640_schedule(s, now + OV2640_EOF_POLL_US);
+            return;
+        }
+        size_t chunk = MIN((size_t)OV2640_BYTES_PER_TICK, s->streaming_length - s->streamed);
+        size_t accepted = esp32_i2s_camera_receive(s->i2s, s->streaming + s->streamed, chunk);
+        s->streamed += accepted;
+        s->phase_start_us = now;
+        if (accepted < chunk && !esp32_i2s_camera_receiving(s->i2s))
+        {
+            /* DMA stopped mid-frame: the rest of the frame is lost, as on hardware. */
+            s->frames_missed++;
+            s->streamed = s->streaming_length;
+        }
+        else if (s->streamed >= s->streaming_length)
+            s->frames_delivered++;
+        if (s->streamed >= s->streaming_length)
+        {
+            s->phase = PHASE_BLANK;
+            ov2640_schedule(s, MAX(now + OV2640_TICK_US, s->frame_start_us + OV2640_FRAME_PERIOD_US));
+            return;
+        }
+        ov2640_schedule(s, now + (accepted < chunk ? OV2640_EOF_POLL_US : OV2640_TICK_US));
+        return;
+    }
+    }
+}
+
+static int ov2640_event(I2CSlave *device, enum i2c_event event)
+{
+    EspemuOv2640 *s = ESPEMU_OV2640(device);
+    if (!s->configured && (event == I2C_START_SEND || event == I2C_START_RECV))
+        return 1;
+    if (event == I2C_START_SEND)
+        s->write_count = 0;
+    return 0;
+}
+
+static int ov2640_send(I2CSlave *device, uint8_t data)
+{
+    EspemuOv2640 *s = ESPEMU_OV2640(device);
+    if (s->write_count++ == 0)
+    {
+        s->address = data;
+        return 0;
+    }
+    uint8_t reg = s->address++;
+    if (reg == 0xff)
+    {
+        s->regs[0][0xff] = s->regs[1][0xff] = data;
+        return 0;
+    }
+    bool sensor_bank = s->regs[0][0xff] & 1;
+    if (sensor_bank && (reg == 0x0a || reg == 0x0b || reg == 0x1c || reg == 0x1d))
+        return 0; /* identification registers are read-only */
+    if (sensor_bank && reg == 0x12 && (data & 0x80))
+    {
+        ov2640_sensor_defaults(s); /* COM7 SRST resets the sensor bank */
+        return 0;
+    }
+    bank_regs(s)[reg] = data;
+    return 0;
+}
+
+static uint8_t ov2640_recv(I2CSlave *device)
+{
+    EspemuOv2640 *s = ESPEMU_OV2640(device);
+    return bank_regs(s)[s->address++];
+}
+
+static void ov2640_reset(DeviceState *device)
+{
+    EspemuOv2640 *s = ESPEMU_OV2640(device);
+    ov2640_defaults(s);
+    s->write_count = 0;
+    s->phase = PHASE_IDLE;
+    /* Counters are per reset epoch; the source picture is the scene in front of the lens and survives reset. */
+    s->frames_started = s->frames_delivered = s->frames_missed = 0;
+    g_clear_pointer(&s->streaming, g_free);
+    s->streaming_length = 0;
+    if (s->configured)
+    {
+        esp32_gpio_drive_input(s->gpio, s->vsync, 0);
+        ov2640_schedule(s, qemu_clock_get_us(QEMU_CLOCK_VIRTUAL) + OV2640_FRAME_PERIOD_US);
+    }
+}
+
+static void ov2640_set_frame(Object *obj, Visitor *visitor, const char *name, void *opaque, Error **errp)
+{
+    EspemuOv2640 *s = ESPEMU_OV2640(obj);
+    g_autofree char *text = NULL;
+    if (!visit_type_str(visitor, name, &text, errp))
+        return;
+    if (!s->configured)
+    {
+        error_setg(errp, "The circuit has no camera");
+        return;
+    }
+    if (strlen(text) > OV2640_MAX_FRAME * 4 / 3 + 512)
+    {
+        error_setg(errp, "Camera frame exceeds %d bytes", OV2640_MAX_FRAME);
+        return;
+    }
+    QObject *object = qobject_from_json(text, errp);
+    if (!object)
+        return;
+    QDict *dict = qobject_to(QDict, object);
+    if (dict && qdict_size(dict) == 2 && qdict_get_try_int(dict, "v", 0) == 1 && qdict_haskey(dict, "clear") &&
+        qdict_get_try_bool(dict, "clear", false))
+    {
+        /* Removing the source stops new frames; a frame already streaming completes from its private copy. */
+        g_clear_pointer(&s->frame, g_free);
+        s->frame_length = 0;
+        s->error[0] = 0;
+        qobject_unref(object);
+        return;
+    }
+    const char *format = dict ? qdict_get_try_str(dict, "format") : NULL;
+    const char *data = dict ? qdict_get_try_str(dict, "data") : NULL;
+    int64_t version = dict ? qdict_get_try_int(dict, "v", 0) : 0, width = dict ? qdict_get_try_int(dict, "width", 0) : 0;
+    int64_t height = dict ? qdict_get_try_int(dict, "height", 0) : 0, seq = dict ? qdict_get_try_int(dict, "seq", -1) : -1;
+    unsigned selected = FORMAT_NONE;
+    for (unsigned index = FORMAT_JPEG; format && index <= FORMAT_YUV422; index++)
+        if (!strcmp(format, format_names[index]))
+            selected = index;
+    gsize length = 0;
+    g_autofree guchar *bytes = data ? g_base64_decode(data, &length) : NULL;
+    const char *problem = NULL;
+    if (!dict || qdict_size(dict) != 6 || version != 1 || seq < 0 || !data || selected == FORMAT_NONE)
+        problem = "Frame needs v:1, seq, format jpeg|rgb565|yuv422, width, height and base64 data";
+    else if (width < 4 || height < 4 || width > 1600 || height > 1200 || width % 4 || height % 4)
+        problem = "Frame size must be 4-1600 x 4-1200 in multiples of 4";
+    else if (!length || length > OV2640_MAX_FRAME)
+        problem = "Frame data is empty or too large";
+    else if (selected != FORMAT_JPEG && length != (gsize)(width * height * 2))
+        problem = "Raw frame length must be width x height x 2";
+    else if (selected == FORMAT_JPEG && (length < 4 || bytes[0] != 0xff || bytes[1] != 0xd8 || bytes[length - 2] != 0xff || bytes[length - 1] != 0xd9))
+        problem = "JPEG frame must start with SOI and end with EOI";
+    if (problem)
+    {
+        error_setg(errp, "%s", problem);
+        qobject_unref(object);
+        return;
+    }
+    g_free(s->frame);
+    s->frame = g_steal_pointer(&bytes);
+    s->frame_length = length;
+    s->frame_format = selected;
+    s->frame_width = width;
+    s->frame_height = height;
+    s->frame_seq = seq;
+    s->error[0] = 0;
+    if (!frame_matches(s))
+        snprintf(s->error, sizeof(s->error), "Source %s %ux%u does not match sensor output %s %ux%u",
+                 format_names[selected], (unsigned)width, (unsigned)height, format_names[sensor_format(s)], sensor_width(s), sensor_height(s));
+    qobject_unref(object);
+}
+
+static void ov2640_get_state(Object *obj, Visitor *visitor, const char *name, void *opaque, Error **errp)
+{
+    EspemuOv2640 *s = ESPEMU_OV2640(obj);
+    QDict *result = qdict_new(), *sensor = qdict_new(), *dma = qdict_new();
+    qdict_put_int(result, "v", 1);
+    qdict_put_bool(result, "configured", s->configured);
+    qdict_put_str(result, "id", s->id);
+    qdict_put_int(result, "vsync", s->vsync);
+    qdict_put_str(sensor, "format", format_names[sensor_format(s)]);
+    qdict_put_int(sensor, "width", sensor_width(s));
+    qdict_put_int(sensor, "height", sensor_height(s));
+    qdict_put(result, "sensor", sensor);
+    if (s->frame)
+    {
+        QDict *source = qdict_new();
+        qdict_put_str(source, "format", format_names[s->frame_format]);
+        qdict_put_int(source, "width", s->frame_width);
+        qdict_put_int(source, "height", s->frame_height);
+        qdict_put_int(source, "seq", s->frame_seq);
+        qdict_put_int(source, "bytes", s->frame_length);
+        qdict_put(result, "source", source);
+    }
+    else
+        qdict_put_null(result, "source");
+    const char *status = !s->configured ? "absent" : !s->frame ? "no-source" : !frame_matches(s) ? "mismatch"
+                       : s->phase == PHASE_STREAM ? "streaming" : s->phase == PHASE_WAIT ? "waiting-for-dma" : "running";
+    qdict_put_str(result, "status", status);
+    qdict_put_int(result, "framesStarted", s->frames_started);
+    qdict_put_int(result, "framesDelivered", s->frames_delivered);
+    qdict_put_int(result, "framesMissed", s->frames_missed);
+    qdict_put_int(dma, "bytes", s->i2s->received_bytes);
+    qdict_put_int(dma, "eofInterrupts", s->i2s->eof_interrupts);
+    qdict_put_int(dma, "descriptorErrors", s->i2s->descriptor_errors);
+    qdict_put_bool(dma, "receiving", esp32_i2s_camera_receiving(s->i2s));
+    qdict_put(result, "dma", dma);
+    qdict_put_str(result, "error", s->error);
+    GString *json = qobject_to_json(QOBJECT(result));
+    char *text = json->str;
+    visit_type_str(visitor, name, &text, errp);
+    g_string_free(json, true);
+    qobject_unref(result);
+}
+
+static void ov2640_init(Object *obj)
+{
+    EspemuOv2640 *s = ESPEMU_OV2640(obj);
+    s->timer = timer_new_us(QEMU_CLOCK_VIRTUAL, ov2640_tick, s);
+    ov2640_defaults(s);
+    object_property_add(obj, "frame", "str", NULL, ov2640_set_frame, NULL, NULL);
+    object_property_add(obj, "state", "str", ov2640_get_state, NULL, NULL, NULL);
+}
+
+static void ov2640_class_init(ObjectClass *klass, void *data)
+{
+    I2CSlaveClass *slave = I2C_SLAVE_CLASS(klass);
+    slave->event = ov2640_event;
+    slave->send = ov2640_send;
+    slave->recv = ov2640_recv;
+    device_class_set_legacy_reset(DEVICE_CLASS(klass), ov2640_reset);
+}
+
+static const TypeInfo ov2640_info = {
+    .name = TYPE_ESPEMU_OV2640,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(EspemuOv2640),
+    .instance_init = ov2640_init,
+    .class_init = ov2640_class_init,
+};
+
+static void ov2640_register_types(void)
+{
+    type_register_static(&ov2640_info);
+}
+type_init(ov2640_register_types)
+
+/* Creates the OV2640 at SCCB address 0x30 on I2C1; it NACKs unless the circuit declares a camera. */
+void espemu_camera_attach(Object *soc, I2CBus *bus, Esp32GpioState *gpio, Esp32I2SState *i2s)
+{
+    I2CSlave *slave = i2c_slave_new(TYPE_ESPEMU_OV2640, 0x30);
+    EspemuOv2640 *s = ESPEMU_OV2640(slave);
+    s->gpio = gpio;
+    s->i2s = i2s;
+    const char *filename = g_getenv("ESPEMU_QEMU_CIRCUIT");
+    if (filename && *filename)
+    {
+        g_autofree char *text = NULL;
+        if (g_file_get_contents(filename, &text, NULL, NULL))
+        {
+            QObject *object = qobject_from_json(text, NULL);
+            QDict *camera = object && qobject_to(QDict, object) ? qobject_to(QDict, qdict_get(qobject_to(QDict, object), "camera")) : NULL;
+            if (camera)
+            {
+                const char *id = qdict_get_try_str(camera, "id");
+                int64_t vsync = qdict_get_try_int(camera, "vsync", -1);
+                if (qdict_size(camera) != 2 || !id || !*id || strlen(id) > 50 || vsync < 0 || vsync > 39 || (vsync >= 6 && vsync <= 11))
+                {
+                    error_report("Invalid camera configuration");
+                    exit(1);
+                }
+                pstrcpy(s->id, sizeof(s->id), id);
+                s->vsync = vsync;
+                s->configured = true;
+            }
+            qobject_unref(object);
+        }
+    }
+    object_property_add_child(soc, "camera", OBJECT(slave));
+    i2c_slave_realize_and_unref(slave, bus, &error_fatal);
+    object_property_add_alias(soc, "espemu-camera-frame", OBJECT(slave), "frame");
+    object_property_add_alias(soc, "espemu-camera-state", OBJECT(slave), "state");
+    if (s->configured)
+    {
+        esp32_gpio_drive_input(gpio, s->vsync, 0);
+        ov2640_schedule(s, qemu_clock_get_us(QEMU_CLOCK_VIRTUAL) + OV2640_FRAME_PERIOD_US);
+    }
+}
diff --git a/hw/sensor/espemu_speaker.c b/hw/sensor/espemu_speaker.c
new file mode 100644
index 0000000..bef0d38
--- /dev/null
+++ b/hw/sensor/espemu_speaker.c
@@ -0,0 +1,228 @@
+/*
+ * MAX98357A I2S class-D amplifier as a sink for ESP32 I2S TX (ESPEmu).
+ * It hears a controller only when the GPIO matrix routes that controller's
+ * DOUT, BCK and WS signals to the wired DIN, BCLK and LRCLK pins. The default
+ * SD_MODE (pulled high through the breakout's resistor) outputs (L+R)/2.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "hw/sensor/espemu.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qapi/qmp/qdict.h"
+#include "qapi/qmp/qjson.h"
+#include "qemu/cutils.h"
+#include "qemu/error-report.h"
+#include "qemu/module.h"
+#include "sysemu/reset.h"
+
+#define TYPE_ESPEMU_SPEAKER "espemu-speaker"
+OBJECT_DECLARE_SIMPLE_TYPE(EspemuSpeaker, ESPEMU_SPEAKER)
+
+#define SPEAKER_BUFFER (192000) /* one second at the highest supported rate */
+static const unsigned dout_signal[2] = {163, 189}, bck_signal[2] = {23, 24}, ws_signal[2] = {25, 26};
+
+struct EspemuSpeaker
+{
+    Object parent_obj;
+    Esp32GpioState *gpio;
+    Esp32I2SState *i2s[2];
+    bool configured;
+    char id[51];
+    unsigned din, bclk, ws;
+    int16_t buffer[SPEAKER_BUFFER];
+    size_t head, count;
+    uint64_t start;   /* sample index of the oldest buffered sample */
+    uint64_t samples; /* samples ever heard */
+    uint64_t dropped;
+    unsigned rate;
+    int controller;
+    int peak;
+    char error[96];
+};
+
+static unsigned routed_signal(EspemuSpeaker *s, unsigned pin)
+{
+    return s->gpio->func_out_sel[pin] & 0x1ff;
+}
+
+/* Index of the I2S controller whose TX signals reach the speaker's pins, or -1. */
+static int routed_controller(EspemuSpeaker *s)
+{
+    for (int index = 0; index < 2; index++)
+        if (routed_signal(s, s->din) == dout_signal[index])
+        {
+            if (routed_signal(s, s->bclk) != bck_signal[index] || routed_signal(s, s->ws) != ws_signal[index])
+            {
+                snprintf(s->error, sizeof(s->error), "DIN is routed to I2S%d but BCLK/LRCLK are not", index);
+                return -1;
+            }
+            s->error[0] = 0;
+            return index;
+        }
+    return -1;
+}
+
+static void speaker_sink(void *opaque, Esp32I2SState *i2s, const int16_t *mono, size_t frames, unsigned rate)
+{
+    EspemuSpeaker *s = opaque;
+    int controller = routed_controller(s);
+    s->controller = controller;
+    if (controller < 0 || s->i2s[controller] != i2s)
+        return;
+    if (rate != s->rate)
+    {
+        /* A new sample rate starts a new stream; unread samples at the old rate are dropped. */
+        s->dropped += s->count;
+        s->start += s->count;
+        s->head = s->count = 0;
+        s->rate = rate;
+    }
+    int peak = 0;
+    for (size_t index = 0; index < frames; index++)
+    {
+        peak = MAX(peak, abs(mono[index]));
+        if (s->count == SPEAKER_BUFFER)
+        {
+            s->head = (s->head + 1) % SPEAKER_BUFFER;
+            s->count--;
+            s->start++;
+            s->dropped++;
+        }
+        s->buffer[(s->head + s->count++) % SPEAKER_BUFFER] = mono[index];
+    }
+    s->samples += frames;
+    s->peak = peak;
+}
+
+static void speaker_get_state(Object *obj, Visitor *visitor, const char *name, void *opaque, Error **errp)
+{
+    EspemuSpeaker *s = ESPEMU_SPEAKER(obj);
+    QDict *result = qdict_new();
+    int controller = s->configured ? routed_controller(s) : -1;
+    Esp32I2SState *i2s = controller >= 0 ? s->i2s[controller] : NULL;
+    qdict_put_int(result, "v", 1);
+    qdict_put_bool(result, "configured", s->configured);
+    qdict_put_str(result, "id", s->id);
+    if (controller >= 0)
+        qdict_put_int(result, "controller", controller);
+    else
+        qdict_put_null(result, "controller");
+    qdict_put_bool(result, "playing", i2s && esp32_i2s_tx_running(i2s));
+    qdict_put_int(result, "rate", i2s ? esp32_i2s_tx_rate(i2s) : 0);
+    qdict_put_int(result, "bits", i2s ? esp32_i2s_tx_bits(i2s) : 0);
+    qdict_put_bool(result, "mono", i2s && esp32_i2s_tx_mono(i2s));
+    qdict_put_int(result, "samples", s->samples);
+    qdict_put_int(result, "underrunFrames", i2s ? i2s->tx_underrun_frames : 0);
+    qdict_put_int(result, "eofInterrupts", i2s ? i2s->tx_eof_interrupts : 0);
+    qdict_put_int(result, "descriptorErrors", i2s ? i2s->tx_descriptor_errors : 0);
+    qdict_put_int(result, "dropped", s->dropped);
+    qdict_put_int(result, "peak", s->peak);
+    qdict_put_str(result, "error", i2s && !esp32_i2s_tx_rate(i2s) && esp32_i2s_tx_running(i2s) ? "Unsupported I2S clock (APLL or invalid dividers)" : s->error);
+    GString *json = qobject_to_json(QOBJECT(result));
+    char *text = json->str;
+    visit_type_str(visitor, name, &text, errp);
+    g_string_free(json, true);
+    qobject_unref(result);
+}
+
+/* Drains buffered PCM: {v, rate, start, data} with data as base64 little-endian int16 mono. */
+static void speaker_get_audio(Object *obj, Visitor *visitor, const char *name, void *opaque, Error **errp)
+{
+    EspemuSpeaker *s = ESPEMU_SPEAKER(obj);
+    g_autofree uint8_t *bytes = g_malloc(s->count * 2 + 1);
+    for (size_t index = 0; index < s->count; index++)
+    {
+        int16_t sample = s->buffer[(s->head + index) % SPEAKER_BUFFER];
+        bytes[index * 2] = sample & 0xff;
+        bytes[index * 2 + 1] = (uint16_t)sample >> 8;
+    }
+    g_autofree char *data = g_base64_encode(bytes, s->count * 2);
+    QDict *result = qdict_new();
+    qdict_put_int(result, "v", 1);
+    qdict_put_int(result, "rate", s->rate);
+    qdict_put_int(result, "start", s->start);
+    qdict_put_str(result, "data", data);
+    s->start += s->count;
+    s->head = s->count = 0;
+    GString *json = qobject_to_json(QOBJECT(result));
+    char *text = json->str;
+    visit_type_str(visitor, name, &text, errp);
+    g_string_free(json, true);
+    qobject_unref(result);
+}
+
+static void speaker_reset(void *opaque)
+{
+    EspemuSpeaker *s = opaque;
+    s->head = s->count = 0;
+    s->start = s->samples = s->dropped = 0;
+    s->rate = 0;
+    s->peak = 0;
+    s->error[0] = 0;
+}
+
+static void speaker_init(Object *obj)
+{
+    object_property_add(obj, "state", "str", speaker_get_state, NULL, NULL, NULL);
+    object_property_add(obj, "audio", "str", speaker_get_audio, NULL, NULL, NULL);
+}
+
+static const TypeInfo speaker_info = {
+    .name = TYPE_ESPEMU_SPEAKER,
+    .parent = TYPE_OBJECT,
+    .instance_size = sizeof(EspemuSpeaker),
+    .instance_init = speaker_init,
+};
+
+static void speaker_register_types(void)
+{
+    type_register_static(&speaker_info);
+}
+type_init(speaker_register_types)
+
+static bool output_pin(int64_t pin)
+{
+    return pin >= 0 && pin < 34 && !(pin >= 6 && pin <= 11);
+}
+
+void espemu_speaker_attach(Object *soc, Esp32GpioState *gpio, Esp32I2SState *i2s0, Esp32I2SState *i2s1)
+{
+    EspemuSpeaker *s = ESPEMU_SPEAKER(object_new(TYPE_ESPEMU_SPEAKER));
+    s->gpio = gpio;
+    s->i2s[0] = i2s0;
+    s->i2s[1] = i2s1;
+    s->controller = -1;
+    const char *filename = g_getenv("ESPEMU_QEMU_CIRCUIT");
+    g_autofree char *text = NULL;
+    if (filename && *filename && g_file_get_contents(filename, &text, NULL, NULL))
+    {
+        QObject *object = qobject_from_json(text, NULL);
+        QDict *speaker = object && qobject_to(QDict, object) ? qobject_to(QDict, qdict_get(qobject_to(QDict, object), "speaker")) : NULL;
+        if (speaker)
+        {
+            const char *id = qdict_get_try_str(speaker, "id");
+            int64_t din = qdict_get_try_int(speaker, "din", -1), bclk = qdict_get_try_int(speaker, "bclk", -1), ws = qdict_get_try_int(speaker, "lrclk", -1);
+            if (qdict_size(speaker) != 4 || !id || !*id || strlen(id) > 50 || !output_pin(din) || !output_pin(bclk) || !output_pin(ws) ||
+                din == bclk || din == ws || bclk == ws)
+            {
+                error_report("Invalid speaker configuration");
+                exit(1);
+            }
+            pstrcpy(s->id, sizeof(s->id), id);
+            s->din = din;
+            s->bclk = bclk;
+            s->ws = ws;
+            s->configured = true;
+            qemu_register_reset(speaker_reset, s);
+            esp32_i2s_set_tx_sink(i2s0, speaker_sink, s);
+            esp32_i2s_set_tx_sink(i2s1, speaker_sink, s);
+        }
+        qobject_unref(object);
+    }
+    object_property_add_child(soc, "speaker", OBJECT(s));
+    object_unref(OBJECT(s));
+    object_property_add_alias(soc, "espemu-speaker-state", OBJECT(s), "state");
+    object_property_add_alias(soc, "espemu-speaker-audio", OBJECT(s), "audio");
+}
diff --git a/hw/sensor/hd44780.c b/hw/sensor/hd44780.c
new file mode 100644
index 0000000..14b3563
--- /dev/null
+++ b/hw/sensor/hd44780.c
@@ -0,0 +1,339 @@
+/*
+ * HD44780-compatible character LCD behind a PCF8574/PCF8574A I2C backpack.
+ * Facts: Hitachi HD44780U datasheet (ADE-207-272): instruction set (table 6),
+ * 4-bit interface (figure 9), DDRAM/CGRAM addressing, busy flag, and execution
+ * times at fosc = 270 kHz. NXP PCF8574 datasheet: quasi-bidirectional port.
+ * Backpack wiring: P0=RS, P1=RW, P2=E, P3=backlight, P4-P7=D4-D7; D0-D3 read 0.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "hw/sensor/espemu.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+
+#define TYPE_HD44780 "espemu-hd44780"
+OBJECT_DECLARE_SIMPLE_TYPE(HD44780State, HD44780)
+
+#define PORT_RS 0x01
+#define PORT_RW 0x02
+#define PORT_E 0x04
+#define PORT_BACKLIGHT 0x08
+#define EXEC_NS 37000
+#define EXEC_ADD_NS 4000
+#define EXEC_LONG_NS 1520000
+
+struct HD44780State
+{
+    I2CSlave parent_obj;
+    bool connected;
+    uint8_t port;
+    uint8_t ddram[80];
+    uint8_t cgram[64];
+    uint8_t ac;
+    bool cgram_selected;
+    bool increment, entry_shift;
+    bool display_on, cursor_on, blink_on;
+    bool eight_bit, two_lines, font_5x10;
+    int shift;
+    bool low_nibble_next;
+    uint8_t pending;
+    bool read_low_next;
+    uint8_t read_value;
+    int64_t busy_until_ns;
+    uint64_t instructions, data_writes, ignored_busy;
+};
+
+static int64_t now_ns(void) { return qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL); }
+static bool busy(HD44780State *s) { return now_ns() < s->busy_until_ns; }
+
+static unsigned ddram_index(HD44780State *s, uint8_t address)
+{
+    return s->two_lines ? (address & 0x40 ? 40 : 0) + (address & 0x3f) % 40 : address % 80;
+}
+
+/* Address counter steps within the active DDRAM map (00-27/40-67 or 00-4F) or the 64-byte CGRAM. */
+static void step_ac(HD44780State *s, bool up)
+{
+    if (s->cgram_selected)
+    {
+        s->ac = (s->ac + (up ? 1 : 63)) & 0x3f;
+        return;
+    }
+    if (!s->two_lines)
+    {
+        s->ac = (s->ac + (up ? 1 : 79)) % 80;
+        return;
+    }
+    unsigned linear = ddram_index(s, s->ac);
+    linear = (linear + (up ? 1 : 79)) % 80;
+    s->ac = linear < 40 ? linear : 0x40 + linear - 40;
+}
+
+static void clear_display(HD44780State *s)
+{
+    memset(s->ddram, ' ', sizeof(s->ddram));
+    s->ac = 0;
+    s->cgram_selected = false;
+    s->increment = true;
+    s->shift = 0;
+}
+
+static void power_on(HD44780State *s)
+{
+    /* Internal reset circuit state (datasheet "Initializing by Internal Reset Circuit"). */
+    clear_display(s);
+    memset(s->cgram, 0, sizeof(s->cgram));
+    s->entry_shift = false;
+    s->display_on = s->cursor_on = s->blink_on = false;
+    s->eight_bit = true;
+    s->two_lines = s->font_5x10 = false;
+    s->low_nibble_next = false;
+    s->read_low_next = false;
+    s->busy_until_ns = 0;
+    s->port = 0xff; /* PCF8574 outputs are high after power-on */
+}
+
+static void instruction(HD44780State *s, uint8_t value)
+{
+    int64_t duration = EXEC_NS;
+    s->instructions++;
+    if (value & 0x80)
+    {
+        s->cgram_selected = false;
+        s->ac = value & 0x7f;
+        if (s->two_lines && (s->ac & 0x3f) >= 40)
+            s->ac &= 0x40; /* undefined addresses wrap to the line start */
+        else if (!s->two_lines && s->ac >= 80)
+            s->ac = 0;
+    }
+    else if (value & 0x40)
+    {
+        s->cgram_selected = true;
+        s->ac = value & 0x3f;
+    }
+    else if (value & 0x20)
+    {
+        bool eight = value & 0x10;
+        if (s->eight_bit && !eight)
+            s->low_nibble_next = false;
+        s->eight_bit = eight;
+        s->two_lines = value & 0x08;
+        s->font_5x10 = (value & 0x04) && !s->two_lines;
+    }
+    else if (value & 0x10)
+    {
+        bool display = value & 0x08, right = value & 0x04;
+        if (display)
+            s->shift = (s->shift + (right ? -1 : 1) + (s->two_lines ? 40 : 80)) % (s->two_lines ? 40 : 80);
+        else
+            step_ac(s, right);
+    }
+    else if (value & 0x08)
+    {
+        s->display_on = value & 0x04;
+        s->cursor_on = value & 0x02;
+        s->blink_on = value & 0x01;
+    }
+    else if (value & 0x04)
+    {
+        s->increment = value & 0x02;
+        s->entry_shift = value & 0x01;
+    }
+    else if (value & 0x02)
+    {
+        s->ac = 0;
+        s->cgram_selected = false;
+        s->shift = 0;
+        duration = EXEC_LONG_NS;
+    }
+    else if (value & 0x01)
+    {
+        clear_display(s);
+        duration = EXEC_LONG_NS;
+    }
+    s->busy_until_ns = now_ns() + duration;
+}
+
+static void write_data(HD44780State *s, uint8_t value)
+{
+    s->data_writes++;
+    if (s->cgram_selected)
+        s->cgram[s->ac & 0x3f] = value & 0x1f;
+    else
+    {
+        s->ddram[ddram_index(s, s->ac)] = value;
+        if (s->entry_shift)
+            s->shift = (s->shift + (s->increment ? 1 : -1) + (s->two_lines ? 40 : 80)) % (s->two_lines ? 40 : 80);
+    }
+    step_ac(s, s->increment);
+    s->busy_until_ns = now_ns() + EXEC_NS + EXEC_ADD_NS;
+}
+
+static void transfer(HD44780State *s, bool rs, uint8_t value)
+{
+    /* A transfer that completes while busy is not executed. */
+    if (busy(s))
+    {
+        s->ignored_busy++;
+        return;
+    }
+    if (rs)
+        write_data(s, value);
+    else
+        instruction(s, value);
+}
+
+static uint8_t read_byte(HD44780State *s, bool rs)
+{
+    if (!rs)
+        return (busy(s) ? 0x80 : 0) | (s->ac & 0x7f);
+    uint8_t value = s->cgram_selected ? s->cgram[s->ac & 0x3f] : s->ddram[ddram_index(s, s->ac)];
+    return value;
+}
+
+static void port_write(HD44780State *s, uint8_t next)
+{
+    uint8_t previous = s->port;
+    bool rs = previous & PORT_RS, rw = previous & PORT_RW;
+    s->port = next;
+    if (!(previous & PORT_E) && (next & PORT_E) && (next & PORT_RW))
+    {
+        /* Read cycle: the controller drives D4-D7 while E is high. */
+        if (s->eight_bit || !s->read_low_next)
+            s->read_value = read_byte(s, next & PORT_RS);
+        return;
+    }
+    if (!(previous & PORT_E) || (next & PORT_E))
+        return;
+    uint8_t nibble = previous >> 4;
+    if (rw)
+    {
+        if (s->eight_bit || s->read_low_next)
+        {
+            if (rs && !busy(s))
+                step_ac(s, s->increment);
+            s->read_low_next = false;
+        }
+        else
+            s->read_low_next = true;
+        return;
+    }
+    s->read_low_next = false;
+    if (s->eight_bit)
+        transfer(s, rs, nibble << 4);
+    else if (!s->low_nibble_next)
+    {
+        s->pending = nibble << 4;
+        s->low_nibble_next = true;
+    }
+    else
+    {
+        s->low_nibble_next = false;
+        transfer(s, rs, s->pending | nibble);
+    }
+}
+
+static uint8_t port_read(HD44780State *s)
+{
+    if (!(s->port & PORT_E) || !(s->port & PORT_RW))
+        return s->port;
+    uint8_t nibble = s->eight_bit || !s->read_low_next ? s->read_value >> 4 : s->read_value & 0x0f;
+    /* Quasi-bidirectional pins: a high output reads the level the controller drives. */
+    return (s->port & 0x0f) | ((s->port & (nibble << 4)) & 0xf0);
+}
+
+static int hd44780_event(I2CSlave *device, enum i2c_event event)
+{
+    HD44780State *s = HD44780(device);
+    return !s->connected && (event == I2C_START_SEND || event == I2C_START_RECV);
+}
+
+static int hd44780_send(I2CSlave *device, uint8_t data)
+{
+    port_write(HD44780(device), data);
+    return 0;
+}
+
+static uint8_t hd44780_recv(I2CSlave *device)
+{
+    return port_read(HD44780(device));
+}
+
+static void hd44780_reset(DeviceState *device)
+{
+    HD44780State *s = HD44780(device);
+    bool connected = s->connected;
+    power_on(s);
+    s->instructions = s->data_writes = s->ignored_busy = 0;
+    s->connected = connected;
+}
+
+static void hd44780_init(Object *obj)
+{
+    HD44780State *s = HD44780(obj);
+    s->connected = true;
+    power_on(s);
+}
+
+static void hd44780_class_init(ObjectClass *klass, void *data)
+{
+    I2CSlaveClass *slave = I2C_SLAVE_CLASS(klass);
+    slave->event = hd44780_event;
+    slave->send = hd44780_send;
+    slave->recv = hd44780_recv;
+    device_class_set_legacy_reset(DEVICE_CLASS(klass), hd44780_reset);
+}
+
+static const TypeInfo hd44780_info = {
+    .name = TYPE_HD44780,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(HD44780State),
+    .instance_init = hd44780_init,
+    .class_init = hd44780_class_init,
+};
+
+static void hd44780_register_types(void)
+{
+    type_register_static(&hd44780_info);
+}
+type_init(hd44780_register_types)
+
+void espemu_hd44780_input(I2CSlave *device, bool connected)
+{
+    HD44780(device)->connected = connected;
+}
+
+static char *hex(const uint8_t *bytes, size_t length)
+{
+    char *text = g_malloc(length * 2 + 1);
+    for (size_t index = 0; index < length; index++)
+        snprintf(text + index * 2, 3, "%02x", bytes[index]);
+    return text;
+}
+
+QDict *espemu_hd44780_state(I2CSlave *device)
+{
+    HD44780State *s = HD44780(device);
+    QDict *result = qdict_new();
+    qdict_put_str(result, "status", !s->connected ? "disconnected" : busy(s) ? "busy" : "idle");
+    qdict_put(result, "channels", qdict_new());
+    qdict_put_bool(result, "backlight", s->port & PORT_BACKLIGHT);
+    qdict_put_bool(result, "displayOn", s->display_on);
+    qdict_put_bool(result, "cursor", s->cursor_on);
+    qdict_put_bool(result, "blink", s->blink_on);
+    qdict_put_bool(result, "twoLines", s->two_lines);
+    qdict_put_bool(result, "font5x10", s->font_5x10);
+    qdict_put_bool(result, "eightBit", s->eight_bit);
+    qdict_put_bool(result, "cgramSelected", s->cgram_selected);
+    qdict_put_int(result, "addressCounter", s->ac);
+    qdict_put_int(result, "shift", s->shift);
+    g_autofree char *ddram = hex(s->ddram, sizeof(s->ddram));
+    g_autofree char *cgram = hex(s->cgram, sizeof(s->cgram));
+    qdict_put_str(result, "ddram", ddram);
+    qdict_put_str(result, "cgram", cgram);
+    qdict_put_int(result, "instructions", s->instructions);
+    qdict_put_int(result, "dataWrites", s->data_writes);
+    qdict_put_int(result, "ignoredWhileBusy", s->ignored_busy);
+    return result;
+}
