+/* Code B uses DP,A,B,C,D,E,F,G in D7..D0 (datasheet tables 5 and 6). */
+static const uint8_t code_b[16] = {
+    0x7e, 0x30, 0x6d, 0x79, 0x33, 0x5b, 0x5f, 0x70,
+    0x7f, 0x7b, 0x01, 0x4f, 0x37, 0x0e, 0x67, 0x00,
+};
+
+static uint8_t max7219_row(const EspemuMax7219Chip *chip, unsigned row)
+{
+    const uint8_t *regs = chip->registers;
+    if (regs[15]) {
+        return 255;
+    }
+    if (!regs[12] || row > regs[11]) {
+        return 0;
+    }
+    uint8_t data = regs[row + 1];
+    return (regs[9] & (1U << row)) ?
+        (code_b[data & 15] | (data & 128)) : data;
+}
+
+void espemu_max7219_update(Esp32GpioState *s, uint64_t levels)
+{
+    for (unsigned index = 0; index < s->matrix.count; index++) {
+        EspemuMax7219Chain *chain = &s->matrix.chains[index];
+        bool clk = !!(levels & (1ULL << chain->clk));
+        bool old_clk = !!(s->last_levels & (1ULL << chain->clk));
+        if (clk && !old_clk) {
+            bool incoming = !!(levels & (1ULL << chain->din));
+            /* MAX7219 shifts even with LOAD high; DOUT changes on falling CLK. */
+            for (unsigned module = 0; module < chain->length; module++) {
+                EspemuMax7219Chip *chip = &chain->chips[module];
+                bool outgoing = chip->dout;
+                chip->shift = (chip->shift << 1) | incoming;
+                incoming = outgoing;
+            }
+        }
+        if (!clk && old_clk) {
+            for (unsigned module = 0; module < chain->length; module++) {
+                chain->chips[module].dout = !!(chain->chips[module].shift & 0x8000);
+            }
+        }
+        if ((levels & (1ULL << chain->load)) &&
+            !(s->last_levels & (1ULL << chain->load))) {
+            for (unsigned module = 0; module < chain->length; module++) {
+                EspemuMax7219Chip *chip = &chain->chips[module];
+                unsigned address = (chip->shift >> 8) & 15;
+                uint8_t data = chip->shift;
+                if (address >= 1 && address <= 9) {
+                    chip->registers[address] = data;
+                } else if (address == 10) {
+                    chip->registers[address] = data & 15;
+                } else if (address == 11) {
+                    chip->registers[address] = data & 7;
+                } else if (address == 12 || address == 15) {
+                    chip->registers[address] = data & 1;
+                }
+            }
+            chain->latches++;
+        }
+    }
+}
+
+void espemu_max7219_reset(Esp32GpioState *s)
+{
+    for (unsigned index = 0; index < s->matrix.count; index++) {
+        EspemuMax7219Chain *chain = &s->matrix.chains[index];
+        memset(chain->chips, 0, sizeof(chain->chips));
+        chain->latches = 0;
+    }
+}
+
+static bool integer(QDict *dict, const char *key, int64_t *value)
+{
+    QNum *number = qobject_to(QNum, qdict_get(dict, key));
+    return number && qnum_get_try_int(number, value);
+}
+
+static bool output_pin(int64_t pin)
+{
+    return pin >= 0 && pin <= 33 && !(pin >= 6 && pin <= 11) &&
+        pin != 20 && pin != 24 && !(pin >= 28 && pin <= 31);
+}
+
+static bool instance_id(const char *id)
+{
+    if (!id || !*id || strlen(id) > 50 || !strcmp(id, "__proto__") ||
+        !strcmp(id, "constructor") || !strcmp(id, "prototype")) {
+        return false;
+    }
+    for (const char *p = id; *p; p++) {
+        if (!g_ascii_isalnum(*p) && *p != '_' && *p != '-') {
+            return false;
+        }
+    }
+    return true;
+}
+
+static void set_config(Object *obj, Visitor *visitor, const char *name,
+                       void *opaque, Error **errp)
+{
+    Esp32GpioState *s = ESP32_GPIO(obj);
+    g_autofree char *text = NULL;
+    if (!visit_type_str(visitor, name, &text, errp)) {
+        return;
+    }
+    if (!s->classic || strlen(text) > 8192) {
+        error_setg(errp, "MAX7219 requires classic ESP32 and a bounded configuration");
+        return;
+    }
+    QObject *object = qobject_from_json(text, errp);
+    if (!object) {
+        return;
+    }
+    QDict *dict = qobject_to(QDict, object);
+    int64_t version;
+    QList *devices = dict ? qobject_to(QList, qdict_get(dict, "devices")) : NULL;
+    bool valid = dict && qdict_size(dict) == 2 &&
+        integer(dict, "v", &version) && version == 1 && devices &&
+        qlist_size(devices) <= ESPEMU_MATRIX_CHAINS;
+    EspemuMax7219 next = {0};
+    uint64_t used = 0;
+    if (valid) {
+        const QListEntry *entry;
+        QLIST_FOREACH_ENTRY(devices, entry) {
+            QDict *device = qobject_to(QDict, qlist_entry_obj(entry));
+            QString *id = device ? qobject_to(QString, qdict_get(device, "id")) : NULL;
+            int64_t din, clk, load, length;
+            const char *text_id = id ? qstring_get_str(id) : NULL;
+            if (!device || qdict_size(device) != 5 || !instance_id(text_id) ||
+                !integer(device, "din", &din) || !output_pin(din) ||
+                !integer(device, "clk", &clk) || !output_pin(clk) ||
+                !integer(device, "load", &load) || !output_pin(load) ||
+                din == clk || din == load || clk == load ||
+                !integer(device, "length", &length) ||
+                length < 1 || length > ESPEMU_MATRIX_MODULES) {
+                valid = false;
+                break;
+            }
+            uint64_t mask = (1ULL << din) | (1ULL << clk) | (1ULL << load);
+            if (used & mask) {
+                valid = false;
+                break;
+            }
+            for (unsigned index = 0; index < next.count; index++) {
+                if (!strcmp(text_id, next.chains[index].id)) {
+                    valid = false;
+                }
+            }
+            if (!valid) {
+                break;
+            }
+            used |= mask;
+            EspemuMax7219Chain *chain = &next.chains[next.count++];
+            pstrcpy(chain->id, sizeof(chain->id), text_id);
+            chain->din = din;
+            chain->clk = clk;
+            chain->load = load;
+            chain->length = length;
+        }
+    }
+    if (valid) {
+        s->matrix = next;
+    } else {
+        error_setg(errp, "MAX7219 requires up to eight unique chains, distinct output pins and 1-16 modules");
+    }
+    qobject_unref(object);
+}
+
+static void get_state(Object *obj, Visitor *visitor, const char *name,
+                      void *opaque, Error **errp)
+{
+    Esp32GpioState *s = ESP32_GPIO(obj);
+    QDict *state = qdict_new();
+    QList *devices = qlist_new();
+    qdict_put_int(state, "v", 1);
+    qdict_put_int(state, "virtualMs", qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL));
+    for (unsigned index = 0; index < s->matrix.count; index++) {
+        EspemuMax7219Chain *chain = &s->matrix.chains[index];
+        QDict *device = qdict_new();
+        QList *modules = qlist_new();
+        qdict_put_str(device, "id", chain->id);
+        qdict_put_int(device, "din", chain->din);
+        qdict_put_int(device, "clk", chain->clk);
+        qdict_put_int(device, "load", chain->load);
+        qdict_put_int(device, "length", chain->length);
+        qdict_put_int(device, "latches", chain->latches);
+        for (unsigned module = 0; module < chain->length; module++) {
+            EspemuMax7219Chip *chip = &chain->chips[module];
+            QDict *item = qdict_new();
+            QList *digits = qlist_new(), *rows = qlist_new();
+            for (unsigned row = 0; row < 8; row++) {
+                qlist_append_int(digits, chip->registers[row + 1]);
+                qlist_append_int(rows, max7219_row(chip, row));
+            }
+            qdict_put(item, "digits", digits);
+            qdict_put(item, "rows", rows);
+            qdict_put_int(item, "decodeMode", chip->registers[9]);
+            qdict_put_int(item, "intensity", chip->registers[10]);
+            qdict_put_int(item, "scanLimit", chip->registers[11]);
+            qdict_put_bool(item, "shutdown", !chip->registers[12]);
+            qdict_put_bool(item, "displayTest", !!chip->registers[15]);
+            qdict_put_int(item, "duty32", chip->registers[15] ?
+                          31 : 2 * chip->registers[10] + 1);
+            qdict_put_int(item, "shift", chip->shift);
+            qdict_put_bool(item, "dout", chip->dout);
+            qlist_append_obj(modules, QOBJECT(item));
+        }
+        qdict_put(device, "modules", modules);
+        qlist_append_obj(devices, QOBJECT(device));
+    }
+    qdict_put(state, "devices", devices);
+    GString *json = qobject_to_json(QOBJECT(state));
+    char *text = json->str;
+    visit_type_str(visitor, name, &text, errp);
+    g_string_free(json, true);
+    qobject_unref(state);
+}
+
+void espemu_max7219_init(Object *obj)
+{
+    object_property_add(obj, "max7219-config", "str", NULL, set_config, NULL, NULL);
+    object_property_add(obj, "max7219-state", "str", get_state, NULL, NULL, NULL);
+}
