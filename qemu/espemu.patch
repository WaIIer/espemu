diff --git a/hw/sensor/mpu6050.c b/hw/sensor/mpu6050.c
new file mode 100644
index 0000000..a77574b
--- /dev/null
+++ b/hw/sensor/mpu6050.c
@@ -0,0 +1,258 @@
+#include "qemu/osdep.h"
+#include "hw/sensor/espemu.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "qapi/qmp/qnum.h"
+#include <math.h>
+
+#define TYPE_MPU6050 "espemu-mpu6050"
+OBJECT_DECLARE_SIMPLE_TYPE(MPU6050State, MPU6050)
+
+struct MPU6050State
+{
+    I2CSlave parent_obj;
+    QEMUTimer *conversion;
+    int64_t gyro_milli_dps[3];
+    int64_t accel_milli_g[3];
+    int64_t temperature_mc;
+    int64_t last_accel_us;
+    uint8_t registers[128];
+    uint8_t read_registers[128];
+    int16_t converted[7];
+    uint8_t pointer;
+    bool expecting_pointer;
+    bool connected;
+    bool invalid;
+    bool sampled;
+    uint64_t samples;
+};
+
+static double mpu6050_gyro_scale(MPU6050State *sensor)
+{
+    static const double scales[] = {131.0, 65.5, 32.8, 16.4};
+    return scales[(sensor->registers[0x1b] >> 3) & 3];
+}
+
+static double mpu6050_accel_scale(MPU6050State *sensor)
+{
+    return 16384 >> ((sensor->registers[0x1c] >> 3) & 3);
+}
+
+static bool mpu6050_unsupported(MPU6050State *sensor)
+{
+    return sensor->registers[0x23] || (sensor->registers[0x6a] & 0xc0) ||
+           (sensor->registers[0x6b] & 0x20);
+}
+
+static int64_t mpu6050_period(MPU6050State *sensor)
+{
+    unsigned filter = sensor->registers[0x1a] & 7;
+    return (filter == 0 || filter == 7 ? 125 : 1000) * (sensor->registers[0x19] + 1);
+}
+
+static int16_t mpu6050_raw(double value)
+{
+    return llround(MIN(32767.0, MAX(-32768.0, value)));
+}
+
+static void mpu6050_schedule(MPU6050State *sensor)
+{
+    timer_del(sensor->conversion);
+    if (!(sensor->registers[0x6b] & 0x40) && !mpu6050_unsupported(sensor))
+    {
+        timer_mod(sensor->conversion, qemu_clock_get_us(QEMU_CLOCK_VIRTUAL) + mpu6050_period(sensor));
+    }
+}
+
+static void mpu6050_convert(void *opaque)
+{
+    MPU6050State *sensor = opaque;
+    int64_t now = qemu_clock_get_us(QEMU_CLOCK_VIRTUAL);
+    if ((sensor->registers[0x6b] & 0x40) || mpu6050_unsupported(sensor))
+    {
+        return;
+    }
+    if (!sensor->sampled || now - sensor->last_accel_us >= 1000)
+    {
+        for (unsigned axis = 0; axis < 3; axis++)
+        {
+            if (!(sensor->registers[0x6c] & (1 << (5 - axis))))
+            {
+                sensor->converted[axis] = mpu6050_raw(sensor->accel_milli_g[axis] * .001 * mpu6050_accel_scale(sensor));
+            }
+        }
+        sensor->last_accel_us = now;
+    }
+    if (!(sensor->registers[0x6b] & 8))
+    {
+        sensor->converted[3] = mpu6050_raw((sensor->temperature_mc * .001 - 36.53) * 340);
+    }
+    for (unsigned axis = 0; axis < 3; axis++)
+    {
+        if (!(sensor->registers[0x6c] & (1 << (2 - axis))))
+        {
+            sensor->converted[axis + 4] = mpu6050_raw(sensor->gyro_milli_dps[axis] * .001 * mpu6050_gyro_scale(sensor));
+        }
+    }
+    for (unsigned channel = 0; channel < 7; channel++)
+    {
+        uint16_t raw = sensor->invalid ? 0x7fff : (uint16_t)sensor->converted[channel];
+        sensor->registers[0x3b + channel * 2] = raw >> 8;
+        sensor->registers[0x3c + channel * 2] = raw & 0xff;
+    }
+    sensor->registers[0x3a] |= 1;
+    sensor->samples++;
+    sensor->sampled = true;
+    mpu6050_schedule(sensor);
+}
+
+static void mpu6050_reset(DeviceState *device)
+{
+    MPU6050State *sensor = MPU6050(device);
+    timer_del(sensor->conversion);
+    memset(sensor->registers, 0, sizeof(sensor->registers));
+    memset(sensor->read_registers, 0, sizeof(sensor->read_registers));
+    memset(sensor->converted, 0, sizeof(sensor->converted));
+    sensor->registers[0x6b] = 0x40;
+    sensor->registers[0x75] = 0x68;
+    sensor->pointer = 0;
+    sensor->sampled = false;
+    sensor->samples = 0;
+}
+
+static int mpu6050_send(I2CSlave *device, uint8_t value)
+{
+    MPU6050State *sensor = MPU6050(device);
+    if (sensor->expecting_pointer)
+    {
+        sensor->pointer = value & 0x7f;
+        sensor->expecting_pointer = false;
+        return 0;
+    }
+    unsigned address = sensor->pointer;
+    sensor->pointer = (sensor->pointer + 1) & 0x7f;
+    if (address == 0x6b && (value & 0x80))
+    {
+        mpu6050_reset(DEVICE(sensor));
+        return 0;
+    }
+    if (address == 0x19 || address == 0x1a || address == 0x1b || address == 0x1c ||
+        address == 0x23 || address == 0x37 || address == 0x38 || address == 0x6a ||
+        address == 0x6b || address == 0x6c)
+    {
+        sensor->registers[address] = address == 0x6a ? value & 0xc0 : value;
+        mpu6050_schedule(sensor);
+    }
+    return 0;
+}
+
+static int mpu6050_event(I2CSlave *device, enum i2c_event event)
+{
+    MPU6050State *sensor = MPU6050(device);
+    if (!sensor->connected && (event == I2C_START_SEND || event == I2C_START_RECV))
+    {
+        return 1;
+    }
+    if (event == I2C_START_SEND)
+    {
+        sensor->expecting_pointer = true;
+    }
+    if (event == I2C_START_RECV)
+    {
+        memcpy(sensor->read_registers, sensor->registers, sizeof(sensor->registers));
+    }
+    return 0;
+}
+
+static uint8_t mpu6050_recv(I2CSlave *device)
+{
+    MPU6050State *sensor = MPU6050(device);
+    unsigned address = sensor->pointer;
+    sensor->pointer = (sensor->pointer + 1) & 0x7f;
+    uint8_t value = sensor->read_registers[address];
+    if (address == 0x3a || (sensor->registers[0x37] & 0x10))
+    {
+        sensor->registers[0x3a] = 0;
+    }
+    return value;
+}
+
+static void mpu6050_init(Object *object)
+{
+    MPU6050State *sensor = MPU6050(object);
+    sensor->connected = true;
+    sensor->temperature_mc = 25000;
+    sensor->accel_milli_g[2] = 1000;
+    sensor->conversion = timer_new_us(QEMU_CLOCK_VIRTUAL, mpu6050_convert, sensor);
+    mpu6050_reset(DEVICE(sensor));
+}
+
+static void mpu6050_finalize(Object *object)
+{
+    timer_free(MPU6050(object)->conversion);
+}
+
+static void mpu6050_class_init(ObjectClass *klass, void *data)
+{
+    I2CSlaveClass *slave = I2C_SLAVE_CLASS(klass);
+    slave->send = mpu6050_send;
+    slave->recv = mpu6050_recv;
+    slave->event = mpu6050_event;
+    device_class_set_legacy_reset(DEVICE_CLASS(klass), mpu6050_reset);
+}
+
+static const TypeInfo mpu6050_info = {
+    .name = TYPE_MPU6050,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(MPU6050State),
+    .instance_init = mpu6050_init,
+    .instance_finalize = mpu6050_finalize,
+    .class_init = mpu6050_class_init,
+};
+
+static void mpu6050_register_types(void)
+{
+    type_register_static(&mpu6050_info);
+}
+type_init(mpu6050_register_types)
+
+    void espemu_mpu6050_input(I2CSlave *device, const int64_t gyro[3], const int64_t accel[3],
+                              int64_t temperature_mc, bool connected, bool invalid)
+{
+    MPU6050State *sensor = MPU6050(device);
+    memcpy(sensor->gyro_milli_dps, gyro, sizeof(sensor->gyro_milli_dps));
+    memcpy(sensor->accel_milli_g, accel, sizeof(sensor->accel_milli_g));
+    sensor->temperature_mc = temperature_mc;
+    sensor->connected = connected;
+    sensor->invalid = invalid;
+}
+
+QDict *espemu_mpu6050_state(I2CSlave *device)
+{
+    MPU6050State *sensor = MPU6050(device);
+    static const char *channels[] = {"accelXg", "accelYg", "accelZg", "temperatureC", "gyroXdps", "gyroYdps", "gyroZdps"};
+    QDict *result = qdict_new(), *values = qdict_new();
+    qdict_put_str(result, "status", !sensor->connected ? "disconnected" : sensor->invalid                ? "invalid"
+                                                                      : mpu6050_unsupported(sensor)      ? "unsupported-mode"
+                                                                      : (sensor->registers[0x6b] & 0x40) ? "sleep"
+                                                                                                         : "sampling");
+    for (unsigned channel = 0; channel < 7; channel++)
+    {
+        double value = channel < 3 ? sensor->converted[channel] / mpu6050_accel_scale(sensor) : channel == 3 ? sensor->converted[channel] / 340.0 + 36.53
+                                                                                                             : sensor->converted[channel] / mpu6050_gyro_scale(sensor);
+        if (!sensor->connected || sensor->invalid || !sensor->sampled || mpu6050_unsupported(sensor))
+        {
+            qdict_put_null(values, channels[channel]);
+        }
+        else
+        {
+            qdict_put(values, channels[channel], qnum_from_double(value));
+        }
+    }
+    qdict_put_int(result, "samples", sensor->samples);
+    qdict_put_int(result, "samplePeriodUs", mpu6050_period(sensor));
+    qdict_put_int(result, "gyroRangeDps", 250 << ((sensor->registers[0x1b] >> 3) & 3));
+    qdict_put_int(result, "accelRangeG", 2 << ((sensor->registers[0x1c] >> 3) & 3));
+    qdict_put(result, "channels", values);
+    return result;
+}
diff --git a/hw/sensor/sht3x.c b/hw/sensor/sht3x.c
new file mode 100644
index 0000000..8b455a2
--- /dev/null
+++ b/hw/sensor/sht3x.c
@@ -0,0 +1,250 @@
+/*
+ * Sensirion SHT3x-DIS humidity/temperature sensor (single-shot subset).
+ * Protocol facts: Sensirion SHT3x-DIS datasheet, version 7 (December 2022),
+ * sections 4.3-4.13: commands, NACK-until-ready readout, CRC-8 and conversion.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include <math.h>
+#include "hw/sensor/espemu.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "qapi/qmp/qnum.h"
+
+#define TYPE_SHT3X "espemu-sht3x"
+OBJECT_DECLARE_SIMPLE_TYPE(SHT3xState, SHT3X)
+
+#define SHT3X_STATUS_ALERT 0x8000
+#define SHT3X_STATUS_HEATER 0x2000
+#define SHT3X_STATUS_RESET 0x0010
+#define SHT3X_STATUS_COMMAND 0x0002
+
+struct SHT3xState
+{
+    I2CSlave parent_obj;
+    QEMUTimer *conversion;
+    int64_t temperature_mc;
+    int64_t humidity_milli;
+    bool connected;
+    bool invalid;
+    uint8_t command[2];
+    unsigned command_length;
+    bool measuring;
+    bool stretching;
+    bool data_ready;
+    bool converted_once;
+    bool status_pending;
+    uint16_t status;
+    uint16_t raw_temperature;
+    uint16_t raw_humidity;
+    uint8_t read_buffer[6];
+    unsigned read_length;
+    unsigned read_offset;
+};
+
+uint8_t espemu_sht3x_crc(const uint8_t data[2])
+{
+    uint8_t crc = 0xff;
+    for (unsigned index = 0; index < 2; index++)
+    {
+        crc ^= data[index];
+        for (unsigned bit = 0; bit < 8; bit++)
+            crc = crc & 0x80 ? (crc << 1) ^ 0x31 : crc << 1;
+    }
+    return crc;
+}
+
+static uint16_t sht3x_scale(double value)
+{
+    return (uint16_t)MIN(65535.0, MAX(0.0, round(value)));
+}
+
+static void sht3x_complete(void *opaque)
+{
+    SHT3xState *s = opaque;
+    s->raw_temperature = sht3x_scale((s->temperature_mc / 1000.0 + 45.0) * 65535.0 / 175.0);
+    s->raw_humidity = sht3x_scale(s->humidity_milli / 1000.0 * 65535.0 / 100.0);
+    s->measuring = false;
+    s->data_ready = true;
+    s->converted_once = true;
+}
+
+static void sht3x_reset_state(SHT3xState *s)
+{
+    timer_del(s->conversion);
+    s->command_length = 0;
+    s->measuring = false;
+    s->stretching = false;
+    s->data_ready = false;
+    s->status_pending = false;
+    s->status = SHT3X_STATUS_ALERT | SHT3X_STATUS_RESET;
+    s->read_length = 0;
+    s->read_offset = 0;
+}
+
+static void sht3x_put_word(SHT3xState *s, uint16_t word, bool corrupt)
+{
+    uint8_t bytes[2] = {word >> 8, word & 0xff};
+    uint8_t crc = espemu_sht3x_crc(bytes);
+    s->read_buffer[s->read_length++] = bytes[0];
+    s->read_buffer[s->read_length++] = bytes[1];
+    s->read_buffer[s->read_length++] = corrupt ? crc ^ 0xff : crc;
+}
+
+static bool sht3x_command(SHT3xState *s, uint16_t command)
+{
+    /* Maximum single-shot durations (Table 4, 2.4-5.5 V), so firmware that waits only the typical time fails here too. */
+    int64_t duration_us = 0;
+    if (command != 0xF32D)
+        s->status &= ~SHT3X_STATUS_COMMAND;
+    switch (command)
+    {
+    case 0x2400: case 0x2C06: duration_us = 15000; break;
+    case 0x240B: case 0x2C0D: duration_us = 6000; break;
+    case 0x2416: case 0x2C10: duration_us = 4000; break;
+    case 0x30A2:
+        sht3x_reset_state(s);
+        return true;
+    case 0x3093:
+        timer_del(s->conversion);
+        s->measuring = false;
+        return true;
+    case 0x306D: s->status |= SHT3X_STATUS_HEATER; return true;
+    case 0x3066: s->status &= ~SHT3X_STATUS_HEATER; return true;
+    case 0x3041: s->status &= ~(SHT3X_STATUS_ALERT | 0x0c00 | SHT3X_STATUS_RESET); return true;
+    case 0xF32D: s->status_pending = true; return true;
+    default:
+        /* Periodic, ART, fetch and alert-limit commands are outside the emulated subset. */
+        s->status |= SHT3X_STATUS_COMMAND;
+        return false;
+    }
+    s->data_ready = false;
+    s->status_pending = false;
+    s->measuring = true;
+    s->stretching = (command >> 8) == 0x2C;
+    timer_mod(s->conversion, qemu_clock_get_us(QEMU_CLOCK_VIRTUAL) + duration_us);
+    return true;
+}
+
+static int sht3x_send(I2CSlave *device, uint8_t data)
+{
+    SHT3xState *s = SHT3X(device);
+    if (s->command_length >= 2)
+        return 1;
+    s->command[s->command_length++] = data;
+    if (s->command_length == 2)
+        return sht3x_command(s, (s->command[0] << 8) | s->command[1]) ? 0 : 1;
+    return 0;
+}
+
+static int sht3x_event(I2CSlave *device, enum i2c_event event)
+{
+    SHT3xState *s = SHT3X(device);
+    if (!s->connected && (event == I2C_START_SEND || event == I2C_START_RECV))
+        return 1;
+    if (event == I2C_START_SEND)
+        s->command_length = 0;
+    if (event == I2C_START_RECV)
+    {
+        s->read_length = 0;
+        s->read_offset = 0;
+        if (s->status_pending)
+        {
+            s->status_pending = false;
+            sht3x_put_word(s, s->status, false);
+            return 0;
+        }
+        /* Clock stretching holds SCL until completion; the controller model has no SCL hold, so finish now. */
+        if (s->measuring && s->stretching)
+        {
+            timer_del(s->conversion);
+            sht3x_complete(s);
+        }
+        if (!s->data_ready)
+            return 1;
+        s->data_ready = false;
+        /* Invalid injection corrupts measurements only, so drivers still initialize and then see bad readings. */
+        sht3x_put_word(s, s->raw_temperature, s->invalid);
+        sht3x_put_word(s, s->raw_humidity, s->invalid);
+    }
+    return 0;
+}
+
+static uint8_t sht3x_recv(I2CSlave *device)
+{
+    SHT3xState *s = SHT3X(device);
+    return s->read_offset < s->read_length ? s->read_buffer[s->read_offset++] : 0xff;
+}
+
+static void sht3x_reset(DeviceState *device)
+{
+    SHT3xState *s = SHT3X(device);
+    sht3x_reset_state(s);
+    s->converted_once = false;
+}
+
+static void sht3x_init(Object *obj)
+{
+    SHT3xState *s = SHT3X(obj);
+    s->connected = true;
+    s->temperature_mc = 25000;
+    s->humidity_milli = 45000;
+    s->conversion = timer_new_us(QEMU_CLOCK_VIRTUAL, sht3x_complete, s);
+    sht3x_reset(DEVICE(s));
+}
+
+static void sht3x_class_init(ObjectClass *klass, void *data)
+{
+    I2CSlaveClass *slave = I2C_SLAVE_CLASS(klass);
+    slave->send = sht3x_send;
+    slave->recv = sht3x_recv;
+    slave->event = sht3x_event;
+    device_class_set_legacy_reset(DEVICE_CLASS(klass), sht3x_reset);
+}
+
+static const TypeInfo sht3x_info = {
+    .name = TYPE_SHT3X,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(SHT3xState),
+    .instance_init = sht3x_init,
+    .class_init = sht3x_class_init,
+};
+
+static void sht3x_register_types(void)
+{
+    type_register_static(&sht3x_info);
+}
+type_init(sht3x_register_types)
+
+void espemu_sht3x_input(I2CSlave *device, int64_t temperature_mc, int64_t humidity_milli, bool connected, bool invalid)
+{
+    SHT3xState *s = SHT3X(device);
+    s->temperature_mc = temperature_mc;
+    s->humidity_milli = humidity_milli;
+    s->connected = connected;
+    s->invalid = invalid;
+}
+
+QDict *espemu_sht3x_state(I2CSlave *device)
+{
+    SHT3xState *s = SHT3X(device);
+    QDict *result = qdict_new(), *channels = qdict_new();
+    qdict_put_str(result, "status", !s->connected ? "disconnected" : s->invalid ? "invalid" : s->measuring ? "converting" : "idle");
+    if (!s->connected || s->invalid || !s->converted_once)
+    {
+        qdict_put_null(channels, "temperatureC");
+        qdict_put_null(channels, "humidityPct");
+    }
+    else
+    {
+        qdict_put(channels, "temperatureC", qnum_from_double(-45.0 + 175.0 * s->raw_temperature / 65535.0));
+        qdict_put(channels, "humidityPct", qnum_from_double(100.0 * s->raw_humidity / 65535.0));
+    }
+    qdict_put_int(result, "rawTemperature", s->raw_temperature);
+    qdict_put_int(result, "rawHumidity", s->raw_humidity);
+    qdict_put_int(result, "statusRegister", s->status);
+    qdict_put_bool(result, "heater", s->status & SHT3X_STATUS_HEATER);
+    qdict_put(result, "channels", channels);
+    return result;
+}
