diff --git a/include/hw/misc/esp32_i2s.h b/include/hw/misc/esp32_i2s.h
new file mode 100644
index 0000000..5ea7813
--- /dev/null
+++ b/include/hw/misc/esp32_i2s.h
@@ -0,0 +1,62 @@
+#pragma once
+
+#include "hw/sysbus.h"
+#include "qemu/timer.h"
+
+#define TYPE_ESP32_I2S "esp32.i2s"
+OBJECT_DECLARE_SIMPLE_TYPE(Esp32I2SState, ESP32_I2S)
+
+/* Receives each TX tick's frames, already mixed to mono, at the controller's sample rate. */
+typedef void (*Esp32I2STxSink)(void *opaque, Esp32I2SState *i2s, const int16_t *mono, size_t frames, unsigned rate);
+
+/* ESP32 I2S: camera-mode RX descriptor DMA and standard-mode master TX descriptor DMA. */
+struct Esp32I2SState
+{
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    uint32_t regs[0x100 / 4];
+    bool link_running;
+    uint32_t descriptor;
+    uint32_t offset;
+    uint32_t words_since_eof;
+    bool have_previous;
+    uint8_t previous;
+    bool have_pending;
+    uint8_t pending;
+    uint64_t received_bytes;
+    uint64_t eof_interrupts;
+    uint64_t descriptor_errors;
+    /* Transmit (standard I2S master) path */
+    unsigned index;
+    QEMUTimer *tx_timer;
+    bool tx_link_running;
+    uint32_t tx_descriptor;
+    uint32_t tx_offset;
+    int64_t tx_last_ns;
+    double tx_frame_credit;
+    uint32_t tx_held;       /* 16-bit mono: second half-word of the last FIFO word */
+    bool tx_have_held;
+    bool tx_starved;        /* no data left in the chain for the rest of this step */
+    uint64_t tx_frames;
+    uint64_t tx_underrun_frames;
+    uint64_t tx_eof_interrupts;
+    uint64_t tx_descriptor_errors;
+    Esp32I2STxSink tx_sink;
+    void *tx_sink_opaque;
+};
+
+/* True while firmware has enabled camera mode, started RX and an input DMA link. */
+bool esp32_i2s_camera_receiving(Esp32I2SState *s);
+/* True while an enabled EOF interrupt has not been cleared by software. */
+bool esp32_i2s_eof_pending(Esp32I2SState *s);
+/* Feeds parallel camera bytes through the configured sampling mode into descriptor DMA; returns bytes accepted. */
+size_t esp32_i2s_camera_receive(Esp32I2SState *s, const uint8_t *data, size_t length);
+/* Resets the sampling-mode pairing at a VSYNC frame boundary. */
+void esp32_i2s_camera_frame_start(Esp32I2SState *s);
+/* Sample rate from the PLL_D2 clock dividers, or 0 when TX is unconfigured or uses the unmodeled APLL. */
+unsigned esp32_i2s_tx_rate(Esp32I2SState *s);
+unsigned esp32_i2s_tx_bits(Esp32I2SState *s);
+bool esp32_i2s_tx_mono(Esp32I2SState *s);
+bool esp32_i2s_tx_running(Esp32I2SState *s);
+void esp32_i2s_set_tx_sink(Esp32I2SState *s, Esp32I2STxSink sink, void *opaque);
