+/*
+ * ESP32 I2S: camera-mode receiver with RX linked-list DMA and standard-mode
+ * master transmitter with TX linked-list DMA paced by the configured sample clock (ESPEmu).
+ * Register layout: ESP-IDF soc/esp32/register/soc/i2s_reg.h; descriptors: esp32/rom/lldesc.h.
+ * Pixel timing, PCLK and HREF are not modeled; bytes arrive through esp32_i2s_camera_receive().
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "hw/misc/esp32_i2s.h"
+#include "hw/irq.h"
+#include "qemu/module.h"
+#include "exec/address-spaces.h"
+#include "sysemu/dma.h"
+
+#define I2S_CONF 0x08
+#define I2S_INT_RAW 0x0c
+#define I2S_INT_ST 0x10
+#define I2S_INT_ENA 0x14
+#define I2S_INT_CLR 0x18
+#define I2S_FIFO_CONF 0x20
+#define I2S_RXEOF_NUM 0x24
+#define I2S_OUT_LINK 0x30
+#define I2S_IN_LINK 0x34
+#define I2S_OUT_EOF_DES_ADDR 0x38
+#define I2S_OUTLINK_DSCR 0x54
+#define I2S_OUTLINK_DSCR_BF0 0x58
+#define I2S_OUTLINK_DSCR_BF1 0x5c
+#define I2S_CLKM_CONF 0xac
+#define I2S_SAMPLE_RATE_CONF 0xb0
+#define I2S_IN_EOF_DES_ADDR 0x3c
+#define I2S_INLINK_DSCR 0x48
+#define I2S_INLINK_DSCR_BF0 0x4c
+#define I2S_INLINK_DSCR_BF1 0x50
+#define I2S_LC_CONF 0x60
+#define I2S_CONF2 0xa8
+#define I2S_DATE 0xfc
+
+#define CONF_TX_RESET (1u << 0)
+#define CONF_TX_FIFO_RESET (1u << 2)
+#define CONF_TX_START (1u << 4)
+#define CONF_RX_RESET (1u << 1)
+#define CONF_RX_FIFO_RESET (1u << 3)
+#define CONF_RX_START (1u << 5)
+#define FIFO_DSCR_EN (1u << 12)
+#define IN_LINK_ADDR 0xfffffu
+#define IN_LINK_STOP (1u << 28)
+#define IN_LINK_START (1u << 29)
+#define IN_LINK_RESTART (1u << 30)
+#define IN_LINK_PARK (1u << 31)
+#define LC_IN_RST (1u << 0)
+#define LC_OUT_RST (1u << 1)
+#define LC_OUT_AUTO_WRBACK (1u << 6)
+#define CLKM_CLKA_EN (1u << 21)
+#define INT_OUT_DONE (1u << 11)
+#define INT_OUT_EOF (1u << 12)
+#define INT_OUT_DSCR_ERR (1u << 14)
+#define INT_OUT_TOTAL_EOF (1u << 16)
+#define TX_TICK_NS 5000000
+#define TX_MAX_FRAMES 8192
+#define LC_CHECK_OWNER (1u << 12)
+#define CONF2_CAMERA_EN (1u << 0)
+#define INT_IN_DONE (1u << 8)
+#define INT_IN_SUC_EOF (1u << 9)
+#define INT_IN_DSCR_ERR (1u << 13)
+#define INT_IN_DSCR_EMPTY (1u << 15)
+
+#define DESC_SIZE_MASK 0xfffu
+#define DESC_LENGTH_SHIFT 12
+#define DESC_EOF (1u << 30)
+#define DESC_OWNER (1u << 31)
+#define DMA_BASE 0x3ff00000u
+
+static uint32_t *reg(Esp32I2SState *s, hwaddr offset) { return &s->regs[offset / 4]; }
+
+static void i2s_irq(Esp32I2SState *s)
+{
+    qemu_set_irq(s->irq, !!(*reg(s, I2S_INT_RAW) & *reg(s, I2S_INT_ENA)));
+}
+
+static void i2s_raise(Esp32I2SState *s, uint32_t bits)
+{
+    *reg(s, I2S_INT_RAW) |= bits;
+    i2s_irq(s);
+}
+
+static void i2s_rx_reset(Esp32I2SState *s)
+{
+    s->have_previous = false;
+    s->have_pending = false;
+}
+
+static void i2s_link_stop(Esp32I2SState *s)
+{
+    s->link_running = false;
+    *reg(s, I2S_IN_LINK) |= IN_LINK_PARK;
+}
+
+static bool i2s_descriptor_valid(uint32_t address)
+{
+    /* Internal DRAM is the only DMA-capable target for I2S on the ESP32. */
+    return address >= 0x3ffae000u && address <= 0x3ffffff4u && !(address & 3);
+}
+
+static bool i2s_load_descriptor(Esp32I2SState *s, uint32_t address)
+{
+    if (!i2s_descriptor_valid(address))
+    {
+        s->descriptor_errors++;
+        i2s_link_stop(s);
+        i2s_raise(s, address ? INT_IN_DSCR_ERR : INT_IN_DSCR_EMPTY);
+        return false;
+    }
+    uint32_t control = ldl_le_phys(&address_space_memory, address);
+    if ((*reg(s, I2S_LC_CONF) & LC_CHECK_OWNER) && !(control & DESC_OWNER))
+    {
+        i2s_link_stop(s);
+        i2s_raise(s, INT_IN_DSCR_EMPTY);
+        return false;
+    }
+    s->descriptor = address;
+    s->offset = 0;
+    *reg(s, I2S_INLINK_DSCR) = address;
+    *reg(s, I2S_INLINK_DSCR_BF0) = ldl_le_phys(&address_space_memory, address + 8);
+    *reg(s, I2S_INLINK_DSCR_BF1) = i2s_descriptor_valid(*reg(s, I2S_INLINK_DSCR_BF0)) ? ldl_le_phys(&address_space_memory, *reg(s, I2S_INLINK_DSCR_BF0) + 8) : 0;
+    return true;
+}
+
+/* Hands the current descriptor back to software and advances to the next one. */
+static void i2s_close_descriptor(Esp32I2SState *s, bool eof)
+{
+    uint32_t control = ldl_le_phys(&address_space_memory, s->descriptor);
+    control = (control & DESC_SIZE_MASK) | ((s->offset & DESC_SIZE_MASK) << DESC_LENGTH_SHIFT) | (eof ? DESC_EOF : 0);
+    stl_le_phys(&address_space_memory, s->descriptor, control);
+    uint32_t done = s->descriptor, next = ldl_le_phys(&address_space_memory, s->descriptor + 8);
+    uint32_t bits = INT_IN_DONE;
+    if (eof)
+    {
+        *reg(s, I2S_IN_EOF_DES_ADDR) = done;
+        s->eof_interrupts++;
+        bits |= INT_IN_SUC_EOF;
+    }
+    i2s_raise(s, bits);
+    if (!next)
+    {
+        i2s_link_stop(s);
+        i2s_raise(s, INT_IN_DSCR_EMPTY);
+        return;
+    }
+    i2s_load_descriptor(s, next);
+}
+
+/* Returns 0 when DMA cannot accept the word, 1 when stored, 2 when the word completed an EOF block. */
+static int i2s_store_word(Esp32I2SState *s, uint32_t word)
+{
+    if (!s->link_running)
+        return 0;
+    uint32_t control = ldl_le_phys(&address_space_memory, s->descriptor);
+    uint32_t size = control & DESC_SIZE_MASK, buffer = ldl_le_phys(&address_space_memory, s->descriptor + 4);
+    /* Re-validated per word because software may rewrite a descriptor the hardware still owns. */
+    if (size < 4 || s->offset + 4 > size || !i2s_descriptor_valid(buffer) || buffer + size > 0x40000000u)
+    {
+        s->descriptor_errors++;
+        i2s_link_stop(s);
+        i2s_raise(s, INT_IN_DSCR_ERR);
+        return 0;
+    }
+    stl_le_phys(&address_space_memory, buffer + s->offset, word);
+    s->offset += 4;
+    s->words_since_eof++;
+    uint32_t eof_words = *reg(s, I2S_RXEOF_NUM);
+    bool eof = eof_words && s->words_since_eof >= eof_words;
+    if (eof)
+        s->words_since_eof = 0;
+    if (eof || s->offset + 4 > size)
+        i2s_close_descriptor(s, eof);
+    return eof ? 2 : 1;
+}
+
+bool esp32_i2s_eof_pending(Esp32I2SState *s)
+{
+    return *reg(s, I2S_INT_RAW) & *reg(s, I2S_INT_ENA) & INT_IN_SUC_EOF;
+}
+
+bool esp32_i2s_camera_receiving(Esp32I2SState *s)
+{
+    return s->link_running && (*reg(s, I2S_CONF2) & CONF2_CAMERA_EN) && (*reg(s, I2S_CONF) & CONF_RX_START) &&
+           (*reg(s, I2S_FIFO_CONF) & FIFO_DSCR_EN);
+}
+
+void esp32_i2s_camera_frame_start(Esp32I2SState *s)
+{
+    i2s_rx_reset(s);
+}
+
+size_t esp32_i2s_camera_receive(Esp32I2SState *s, const uint8_t *data, size_t length)
+{
+    size_t index = 0;
+    unsigned mode = (*reg(s, I2S_FIFO_CONF) >> 16) & 7;
+    while (index < length && esp32_i2s_camera_receiving(s))
+    {
+        uint8_t byte = data[index];
+        int stored = 1;
+        if (mode == 0)
+        {
+            /* SM_0A0B_0B0C: every byte pairs with its successor. */
+            if (s->have_previous)
+                stored = i2s_store_word(s, ((uint32_t)s->previous << 16) | byte);
+            s->previous = byte;
+            s->have_previous = true;
+        }
+        else if (mode == 1)
+        {
+            /* SM_0A0B_0C0D: two bytes per word. */
+            if (s->have_pending)
+            {
+                stored = i2s_store_word(s, ((uint32_t)s->pending << 16) | byte);
+                s->have_pending = false;
+            }
+            else
+            {
+                s->pending = byte;
+                s->have_pending = true;
+            }
+        }
+        else
+            /* SM_0A00_0B00 and other modes: one byte per word. */
+            stored = i2s_store_word(s, (uint32_t)byte << 16);
+        if (!stored)
+            break;
+        index++;
+        s->received_bytes++;
+        /* Pixel data keeps arriving on hardware while the EOF interrupt is serviced; pausing here lets the caller give the guest that time. */
+        if (stored == 2)
+            break;
+    }
+    return index;
+}
+
+unsigned esp32_i2s_tx_bits(Esp32I2SState *s) { return (*reg(s, I2S_SAMPLE_RATE_CONF) >> 12) & 0x3f; }
+static unsigned tx_fifo_mod(Esp32I2SState *s) { return (*reg(s, I2S_FIFO_CONF) >> 13) & 7; }
+bool esp32_i2s_tx_mono(Esp32I2SState *s) { return tx_fifo_mod(s) & 1; }
+/* tx_fifo_mod follows the slot width (ESP-IDF i2s_ll_tx_set_sample_bit): 0/1 = 16-bit slots, 2/3 = 32-bit slots. */
+static bool tx_wide(Esp32I2SState *s) { return tx_fifo_mod(s) >= 2; }
+
+unsigned esp32_i2s_tx_rate(Esp32I2SState *s)
+{
+    uint32_t clkm = *reg(s, I2S_CLKM_CONF);
+    unsigned integer = clkm & 0xff, numerator = (clkm >> 8) & 0x3f, denominator = (clkm >> 14) & 0x3f;
+    unsigned bck = *reg(s, I2S_SAMPLE_RATE_CONF) & 0x3f, bits = esp32_i2s_tx_bits(s);
+    if ((clkm & CLKM_CLKA_EN) || integer < 2 || bck < 2 || (bits != 16 && bits != 24 && bits != 32) || tx_fifo_mod(s) > 3)
+        return 0;
+    double divider = integer + (denominator ? (double)numerator / denominator : 0);
+    double rate = 160e6 / divider / bck / (2.0 * (tx_wide(s) ? 32 : 16));
+    return rate >= 4000 && rate <= 192000 ? (unsigned)(rate + 0.5) : 0;
+}
+
+bool esp32_i2s_tx_running(Esp32I2SState *s)
+{
+    return (*reg(s, I2S_CONF) & CONF_TX_START) && !(*reg(s, I2S_CONF2) & CONF2_CAMERA_EN);
+}
+
+void esp32_i2s_set_tx_sink(Esp32I2SState *s, Esp32I2STxSink sink, void *opaque)
+{
+    s->tx_sink = sink;
+    s->tx_sink_opaque = opaque;
+}
+
+static void tx_link_stop(Esp32I2SState *s)
+{
+    s->tx_link_running = false;
+    s->tx_have_held = false;
+}
+
+static bool tx_load(Esp32I2SState *s, uint32_t address)
+{
+    if (!i2s_descriptor_valid(address))
+    {
+        if (address)
+            s->tx_descriptor_errors++;
+        tx_link_stop(s);
+        i2s_raise(s, address ? INT_OUT_DSCR_ERR : INT_OUT_TOTAL_EOF);
+        return false;
+    }
+    s->tx_descriptor = address;
+    s->tx_offset = 0;
+    *reg(s, I2S_OUTLINK_DSCR) = address;
+    *reg(s, I2S_OUTLINK_DSCR_BF0) = ldl_le_phys(&address_space_memory, address + 8);
+    *reg(s, I2S_OUTLINK_DSCR_BF1) = i2s_descriptor_valid(*reg(s, I2S_OUTLINK_DSCR_BF0)) ? ldl_le_phys(&address_space_memory, *reg(s, I2S_OUTLINK_DSCR_BF0) + 8) : 0;
+    return true;
+}
+
+/* Pops one FIFO word from TX descriptor DMA; false on underrun or a descriptor fault. */
+static bool tx_word(Esp32I2SState *s, uint32_t *word)
+{
+    /* A chain of empty descriptors yields no data instead of spinning inside one tick. */
+    for (unsigned hops = 0; s->tx_link_running && !s->tx_starved; hops++)
+    {
+        if (hops == 64)
+        {
+            s->tx_starved = true;
+            return false;
+        }
+        uint32_t control = ldl_le_phys(&address_space_memory, s->tx_descriptor);
+        uint32_t length = (control >> DESC_LENGTH_SHIFT) & DESC_SIZE_MASK, buffer = ldl_le_phys(&address_space_memory, s->tx_descriptor + 4);
+        if (s->tx_offset + 4 <= length)
+        {
+            if (!i2s_descriptor_valid(buffer) || buffer + length > 0x40000000u)
+            {
+                s->tx_descriptor_errors++;
+                tx_link_stop(s);
+                i2s_raise(s, INT_OUT_DSCR_ERR);
+                return false;
+            }
+            *word = ldl_le_phys(&address_space_memory, buffer + s->tx_offset);
+            s->tx_offset += 4;
+            return true;
+        }
+        /* Descriptor drained: hand it back, report EOF, follow the chain. */
+        if (*reg(s, I2S_LC_CONF) & LC_OUT_AUTO_WRBACK)
+            stl_le_phys(&address_space_memory, s->tx_descriptor, control & ~DESC_OWNER);
+        uint32_t bits = INT_OUT_DONE;
+        if (control & DESC_EOF)
+        {
+            *reg(s, I2S_OUT_EOF_DES_ADDR) = s->tx_descriptor;
+            s->tx_eof_interrupts++;
+            bits |= INT_OUT_EOF;
+        }
+        i2s_raise(s, bits);
+        uint32_t next = ldl_le_phys(&address_space_memory, s->tx_descriptor + 8);
+        if (!tx_load(s, next))
+            return false;
+    }
+    return false;
+}
+
+static void tx_tick(void *opaque)
+{
+    Esp32I2SState *s = opaque;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    unsigned rate = esp32_i2s_tx_rate(s);
+    if (!esp32_i2s_tx_running(s))
+        return;
+    timer_mod(s->tx_timer, now + TX_TICK_NS);
+    s->tx_frame_credit += rate * (double)(now - s->tx_last_ns) / 1e9;
+    s->tx_last_ns = now;
+    if (!rate)
+    {
+        s->tx_frame_credit = 0;
+        return;
+    }
+    size_t frames = MIN((size_t)s->tx_frame_credit, (size_t)TX_MAX_FRAMES);
+    s->tx_frame_credit -= frames;
+    if (s->tx_frame_credit > TX_MAX_FRAMES)
+        s->tx_frame_credit = 0;
+    g_autofree int16_t *mono = g_new0(int16_t, frames ? frames : 1);
+    bool wide = tx_wide(s), single = esp32_i2s_tx_mono(s);
+    s->tx_starved = false;
+    for (size_t frame = 0; frame < frames; frame++)
+    {
+        uint32_t first, second;
+        int32_t left, right;
+        bool ok;
+        if (!wide && single)
+        {
+            /* 16-bit mono: each FIFO word carries two consecutive samples, low half first. */
+            if (!s->tx_have_held)
+            {
+                ok = tx_word(s, &s->tx_held);
+                s->tx_have_held = ok;
+                left = right = ok ? (int16_t)s->tx_held : 0;
+            }
+            else
+            {
+                left = right = (int16_t)(s->tx_held >> 16);
+                s->tx_have_held = false;
+                ok = true;
+            }
+        }
+        else if (!wide)
+        {
+            ok = tx_word(s, &first);
+            left = (int16_t)first;
+            right = (int16_t)(first >> 16);
+        }
+        else if (single)
+        {
+            ok = tx_word(s, &first);
+            left = right = (int16_t)(first >> 16);
+        }
+        else
+        {
+            ok = tx_word(s, &first) && tx_word(s, &second);
+            left = (int16_t)(first >> 16);
+            right = (int16_t)(second >> 16);
+        }
+        if (!ok)
+        {
+            s->tx_underrun_frames++;
+            left = right = 0;
+        }
+        mono[frame] = (int16_t)((left + right) / 2);
+    }
+    s->tx_frames += frames;
+    if (frames && s->tx_sink)
+        s->tx_sink(s->tx_sink_opaque, s, mono, frames, rate);
+}
+
+static void tx_update(Esp32I2SState *s)
+{
+    if (esp32_i2s_tx_running(s) && !timer_pending(s->tx_timer))
+    {
+        s->tx_last_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        s->tx_frame_credit = 0;
+        timer_mod(s->tx_timer, s->tx_last_ns + TX_TICK_NS);
+    }
+}
+
+static uint64_t i2s_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Esp32I2SState *s = opaque;
+    switch (addr)
+    {
+    case I2S_INT_ST:
+        return *reg(s, I2S_INT_RAW) & *reg(s, I2S_INT_ENA);
+    case I2S_IN_LINK:
+        return (*reg(s, I2S_IN_LINK) & (IN_LINK_ADDR | IN_LINK_PARK)) | (s->link_running ? 0 : IN_LINK_PARK);
+    case I2S_OUT_LINK:
+        return (*reg(s, I2S_OUT_LINK) & IN_LINK_ADDR) | (s->tx_link_running ? 0 : IN_LINK_PARK);
+    case I2S_DATE:
+        return 0x1604201;
+    default:
+        return addr < sizeof(s->regs) ? *reg(s, addr) : 0;
+    }
+}
+
+static void i2s_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    Esp32I2SState *s = opaque;
+    if (addr >= sizeof(s->regs))
+        return;
+    switch (addr)
+    {
+    case I2S_INT_RAW:
+    case I2S_INT_ST:
+    case I2S_IN_EOF_DES_ADDR:
+    case I2S_OUT_EOF_DES_ADDR:
+    case I2S_OUTLINK_DSCR:
+    case I2S_OUTLINK_DSCR_BF0:
+    case I2S_OUTLINK_DSCR_BF1:
+    case I2S_INLINK_DSCR:
+    case I2S_INLINK_DSCR_BF0:
+    case I2S_INLINK_DSCR_BF1:
+    case I2S_DATE:
+        return;
+    case I2S_INT_CLR:
+        *reg(s, I2S_INT_RAW) &= ~(uint32_t)value;
+        i2s_irq(s);
+        return;
+    case I2S_INT_ENA:
+        *reg(s, I2S_INT_ENA) = value;
+        i2s_irq(s);
+        return;
+    case I2S_CONF:
+        *reg(s, I2S_CONF) = value & ~(CONF_RX_RESET | CONF_RX_FIFO_RESET | CONF_TX_RESET | CONF_TX_FIFO_RESET);
+        if (value & (CONF_RX_RESET | CONF_RX_FIFO_RESET))
+            i2s_rx_reset(s);
+        tx_update(s);
+        return;
+    case I2S_LC_CONF:
+        *reg(s, I2S_LC_CONF) = value;
+        if (value & LC_IN_RST)
+        {
+            s->link_running = false;
+            s->words_since_eof = 0;
+            i2s_rx_reset(s);
+        }
+        if (value & LC_OUT_RST)
+            tx_link_stop(s);
+        return;
+    case I2S_OUT_LINK:
+        *reg(s, I2S_OUT_LINK) = value & IN_LINK_ADDR;
+        if (value & IN_LINK_STOP)
+            tx_link_stop(s);
+        if (value & (IN_LINK_START | IN_LINK_RESTART))
+        {
+            s->tx_have_held = false;
+            s->tx_link_running = tx_load(s, DMA_BASE | (value & IN_LINK_ADDR));
+        }
+        return;
+    case I2S_IN_LINK:
+        *reg(s, I2S_IN_LINK) = (value & IN_LINK_ADDR) | (s->link_running ? 0 : IN_LINK_PARK);
+        if (value & IN_LINK_STOP)
+            i2s_link_stop(s);
+        if (value & (IN_LINK_START | IN_LINK_RESTART))
+        {
+            s->words_since_eof = 0;
+            s->link_running = i2s_load_descriptor(s, DMA_BASE | (value & IN_LINK_ADDR));
+            if (s->link_running)
+                *reg(s, I2S_IN_LINK) &= ~IN_LINK_PARK;
+        }
+        return;
+    default:
+        *reg(s, addr) = value;
+    }
+}
+
+static const MemoryRegionOps i2s_ops = {
+    .read = i2s_read,
+    .write = i2s_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {.min_access_size = 4, .max_access_size = 4},
+};
+
+static void i2s_reset_hold(Object *obj, ResetType type)
+{
+    Esp32I2SState *s = ESP32_I2S(obj);
+    memset(s->regs, 0, sizeof(s->regs));
+    *reg(s, I2S_IN_LINK) = IN_LINK_PARK;
+    s->link_running = false;
+    s->words_since_eof = 0;
+    s->received_bytes = s->eof_interrupts = s->descriptor_errors = 0;
+    s->tx_link_running = false;
+    s->tx_frames = s->tx_underrun_frames = s->tx_eof_interrupts = s->tx_descriptor_errors = 0;
+    s->tx_frame_credit = 0;
+    s->tx_have_held = false;
+    if (s->tx_timer)
+        timer_del(s->tx_timer);
+    i2s_rx_reset(s);
+    i2s_irq(s);
+}
+
+static void i2s_init(Object *obj)
+{
+    Esp32I2SState *s = ESP32_I2S(obj);
+    memory_region_init_io(&s->iomem, obj, &i2s_ops, s, TYPE_ESP32_I2S, sizeof(s->regs));
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+    s->tx_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, tx_tick, s);
+}
+
+static void i2s_class_init(ObjectClass *klass, void *data)
+{
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+    rc->phases.hold = i2s_reset_hold;
+}
+
+static const TypeInfo i2s_info = {
+    .name = TYPE_ESP32_I2S,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Esp32I2SState),
+    .instance_init = i2s_init,
+    .class_init = i2s_class_init,
+};
+
+static void i2s_register_types(void)
+{
+    type_register_static(&i2s_info);
+}
+type_init(i2s_register_types)
diff --git a/hw/misc/esp32_rmt.c b/hw/misc/esp32_rmt.c
new file mode 100644
index 0000000..4afc863
--- /dev/null
+++ b/hw/misc/esp32_rmt.c
@@ -0,0 +1,340 @@
+#include "qemu/osdep.h"
+#include "hw/misc/esp32_rmt.h"
+#include "hw/irq.h"
+#include "qemu/module.h"
+#include "qemu/cutils.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qapi/qmp/qdict.h"
+#include "qapi/qmp/qlist.h"
+#include "qapi/qmp/qjson.h"
+#include "qapi/qmp/qnum.h"
+
+static void rmt_irq(Esp32RmtState *s) { qemu_set_irq(s->irq, !!(s->raw & s->enabled)); }
+static uint64_t rmt_tick_ns(Esp32RmtState *s, unsigned channel)
+{
+    unsigned divider = s->registers[(0x20 + channel * 8) / 4] & 255;
+    if (!divider)
+        divider = 256;
+    return (s->registers[(0x24 + channel * 8) / 4] & (1U << 17)) ? divider * 1000ULL / 80 : divider * 1000ULL;
+}
+static void rmt_latch(Esp32RmtChannel *channel)
+{
+    Esp32RmtState *s = channel->owner;
+    for (unsigned index = 0; index < s->device_count; index++)
+    {
+        unsigned pin = s->devices[index].pin;
+        if (!s->gpio || (s->gpio->func_out_sel[pin] & 511) != 87 + channel->index)
+            continue;
+        unsigned length = s->devices[index].length;
+        if (channel->invalid || channel->bits < length * 24)
+        {
+            pstrcpy(s->error, sizeof(s->error), "Incomplete or invalid WS2812 GRB waveform");
+            continue;
+        }
+        for (unsigned pixel = 0; pixel < length; pixel++)
+        {
+            s->devices[index].pixels[pixel][0] = channel->bytes[pixel * 3 + 1];
+            s->devices[index].pixels[pixel][1] = channel->bytes[pixel * 3];
+            s->devices[index].pixels[pixel][2] = channel->bytes[pixel * 3 + 2];
+        }
+        s->devices[index].frames++;
+    }
+    channel->bits = 0;
+    memset(channel->bytes, 0, sizeof(channel->bytes));
+    channel->invalid = false;
+}
+static void rmt_decode(Esp32RmtChannel *channel, uint32_t word)
+{
+    Esp32RmtState *s = channel->owner;
+    uint64_t tick = rmt_tick_ns(s, channel->index);
+    unsigned duration0 = word & 32767, duration1 = (word >> 16) & 32767;
+    bool level0 = !!(word & (1U << 15)), level1 = !!(word & (1U << 31));
+    if ((!level0 && duration0 * tick >= 50000) || (!level1 && duration1 * tick >= 50000))
+    {
+        rmt_latch(channel);
+        return;
+    }
+    if (!duration0)
+        return;
+    uint64_t high = (level0 ? duration0 : duration1) * tick, low = (level0 ? duration1 : duration0) * tick;
+    if (level0 == level1 || high < 150 || high > 1100 || low < 150 || low > 1500 || high + low < 600 || high + low > 2000)
+    {
+        channel->invalid = true;
+        return;
+    }
+    if (channel->bits < sizeof(channel->bytes) * 8)
+    {
+        channel->bytes[channel->bits / 8] = (channel->bytes[channel->bits / 8] << 1) | (high > low);
+        channel->bits++;
+    }
+}
+static void rmt_schedule(Esp32RmtChannel *channel)
+{
+    Esp32RmtState *s = channel->owner;
+    unsigned blocks = (s->registers[(0x20 + channel->index * 8) / 4] >> 24) & 15;
+    unsigned capacity = blocks * 64;
+    if (!blocks || capacity > (8 - channel->index) * 64)
+    {
+        pstrcpy(s->error, sizeof(s->error), "Invalid RMT memory block configuration");
+        channel->active = false;
+        s->raw |= 1U << (channel->index * 3 + 2);
+        rmt_irq(s);
+        return;
+    }
+    unsigned limit = s->registers[(0xd0 + channel->index * 4) / 4] & 511;
+    if (!limit)
+        limit = capacity;
+    channel->pending_count = 0;
+    channel->finishing = false;
+    uint64_t duration = 0;
+    while (channel->pending_count < MIN(limit, 512U))
+    {
+        uint32_t word = s->memory[channel->index * 64 + channel->position];
+        unsigned first = word & 32767, second = (word >> 16) & 32767;
+        channel->pending[channel->pending_count++] = word;
+        duration += (first + second) * rmt_tick_ns(s, channel->index);
+        channel->position++;
+        channel->total++;
+        if (!first || !second)
+        {
+            channel->finishing = true;
+            break;
+        }
+        if (channel->position == capacity)
+        {
+            if (!(s->registers[0xf0 / 4] & 2))
+            {
+                channel->finishing = true;
+                break;
+            }
+            channel->position = 0;
+        }
+    }
+    timer_mod(channel->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + MAX(duration, 1000ULL));
+}
+static void rmt_complete(void *opaque)
+{
+    Esp32RmtChannel *channel = opaque;
+    Esp32RmtState *s = channel->owner;
+    if (!channel->active)
+        return;
+    for (unsigned index = 0; index < channel->pending_count; index++)
+        rmt_decode(channel, channel->pending[index]);
+    if (channel->finishing)
+    {
+        channel->active = false;
+        s->registers[(0x24 + channel->index * 8) / 4] &= ~1U;
+        s->raw |= 1U << (channel->index * 3);
+    }
+    else
+        s->raw |= 1U << (channel->index + 24);
+    rmt_irq(s);
+    if (channel->active)
+        rmt_schedule(channel);
+}
+static uint64_t rmt_read(void *opaque, hwaddr address, unsigned size)
+{
+    Esp32RmtState *s = opaque;
+    if (address >= 0x800 && address < 0x1000)
+        return s->memory[(address - 0x800) / 4];
+    if (address == 0xa0)
+        return s->raw;
+    if (address == 0xa4)
+        return s->raw & s->enabled;
+    if (address == 0xa8)
+        return s->enabled;
+    if (address >= 0x60 && address < 0x80)
+        return s->channels[(address - 0x60) / 4].position;
+    if (address < 0x100)
+        return s->registers[address / 4];
+    return 0;
+}
+static void rmt_write(void *opaque, hwaddr address, uint64_t value, unsigned size)
+{
+    Esp32RmtState *s = opaque;
+    if (address >= 0x800 && address < 0x1000)
+    {
+        s->memory[(address - 0x800) / 4] = value;
+        return;
+    }
+    if (address == 0xa8)
+    {
+        s->enabled = value;
+        rmt_irq(s);
+        return;
+    }
+    if (address == 0xac)
+    {
+        s->raw &= ~value;
+        rmt_irq(s);
+        return;
+    }
+    if (address >= 0x100)
+        return;
+    s->registers[address / 4] = value;
+    if (address >= 0x24 && address <= 0x5c && (address - 0x24) % 8 == 0)
+    {
+        unsigned index = (address - 0x24) / 8;
+        Esp32RmtChannel *channel = &s->channels[index];
+        if (value & 8)
+            channel->position = 0;
+        if (value & 1)
+        {
+            if ((value & ((1U << 1) | (1U << 6))) || (s->registers[(address - 4) / 4] & (1U << 28)))
+            {
+                pstrcpy(s->error, sizeof(s->error), "RMT RX, loop and carrier modes are unsupported");
+                s->raw |= 1U << (index * 3 + 2);
+                rmt_irq(s);
+                return;
+            }
+            channel->active = true;
+            channel->position = 0;
+            channel->total = 0;
+            channel->bits = 0;
+            channel->invalid = false;
+            memset(channel->bytes, 0, sizeof(channel->bytes));
+            s->error[0] = 0;
+            rmt_schedule(channel);
+        }
+    }
+}
+static const MemoryRegionOps rmt_ops = {.read = rmt_read, .write = rmt_write, .endianness = DEVICE_LITTLE_ENDIAN};
+static void rmt_get_pixels(Object *obj, Visitor *visitor, const char *name, void *opaque, Error **errp)
+{
+    Esp32RmtState *s = ESP32_RMT(obj);
+    QDict *result = qdict_new();
+    QList *devices = qlist_new();
+    qdict_put_int(result, "v", 1);
+    qdict_put_int(result, "virtualMs", qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL));
+    qdict_put_str(result, "error", s->error);
+    for (unsigned index = 0; index < s->device_count; index++)
+    {
+        QDict *device = qdict_new();
+        QList *pixels = qlist_new();
+        qdict_put_str(device, "id", s->devices[index].id);
+        qdict_put_int(device, "pin", s->devices[index].pin);
+        qdict_put_int(device, "length", s->devices[index].length);
+        qdict_put_int(device, "frames", s->devices[index].frames);
+        for (unsigned pixel = 0; pixel < s->devices[index].length; pixel++)
+        {
+            QList *rgb = qlist_new();
+            for (unsigned color = 0; color < 3; color++)
+                qlist_append_obj(rgb, QOBJECT(qnum_from_int(s->devices[index].pixels[pixel][color])));
+            qlist_append_obj(pixels, QOBJECT(rgb));
+        }
+        qdict_put(device, "pixels", pixels);
+        qlist_append_obj(devices, QOBJECT(device));
+    }
+    qdict_put(result, "devices", devices);
+    GString *json = qobject_to_json(QOBJECT(result));
+    char *text = json->str;
+    visit_type_str(visitor, name, &text, errp);
+    g_string_free(json, true);
+    qobject_unref(result);
+}
+static void rmt_set_config(Object *obj, Visitor *visitor, const char *name, void *opaque, Error **errp)
+{
+    Esp32RmtState *s = ESP32_RMT(obj);
+    g_autofree char *text = NULL;
+    if (!visit_type_str(visitor, name, &text, errp))
+        return;
+    if (strlen(text) > 32768)
+    {
+        error_setg(errp, "WS2812 configuration exceeds limit");
+        return;
+    }
+    QObject *object = qobject_from_json(text, errp);
+    if (!object)
+        return;
+    QDict *dict = qobject_to(QDict, object);
+    QList *devices = dict ? qobject_to(QList, qdict_get(dict, "devices")) : NULL;
+    QNum *version = dict ? qobject_to(QNum, qdict_get(dict, "v")) : NULL;
+    int64_t version_value;
+    bool valid = dict && qdict_size(dict) == 2 && devices && version && qnum_get_try_int(version, &version_value) && version_value == 1;
+    unsigned count = 0, total = 0;
+    uint64_t pins = 0;
+    typeof(s->devices) next = {0};
+    if (valid)
+    {
+        const QListEntry *entry;
+        QLIST_FOREACH_ENTRY(devices, entry)
+        {
+            QDict *device = qobject_to(QDict, qlist_entry_obj(entry));
+            const char *id = device ? qdict_get_try_str(device, "id") : NULL;
+            QNum *pin = device ? qobject_to(QNum, qdict_get(device, "pin")) : NULL, *length = device ? qobject_to(QNum, qdict_get(device, "length")) : NULL;
+            int64_t pin_value, length_value;
+            if (!device || qdict_size(device) != 3 || !id || !*id || strlen(id) > 50 || !pin || !length || !qnum_get_try_int(pin, &pin_value) || !qnum_get_try_int(length, &length_value) || pin_value < 0 || pin_value > 33 || (pin_value >= 6 && pin_value <= 11) || pin_value == 20 || pin_value == 24 || (pin_value >= 28 && pin_value <= 31) || length_value < 1 || length_value > 1024 || count >= 32 || (pins & (1ULL << pin_value)))
+            {
+                valid = false;
+                break;
+            }
+            for (unsigned index = 0; index < count; index++)
+                if (!strcmp(next[index].id, id))
+                    valid = false;
+            if (!valid)
+                break;
+            total += length_value;
+            if (total > 2048)
+            {
+                valid = false;
+                break;
+            }
+            pins |= 1ULL << pin_value;
+            pstrcpy(next[count].id, sizeof(next[count].id), id);
+            next[count].pin = pin_value;
+            next[count].length = length_value;
+            count++;
+        }
+    }
+    if (valid)
+    {
+        memcpy(s->devices, next, sizeof(next));
+        s->device_count = count;
+        s->error[0] = 0;
+    }
+    else
+        error_setg(errp, "Invalid WS2812 ids/pins/lengths or more than 2048 total pixels");
+    qobject_unref(object);
+}
+static void rmt_reset(Object *obj, ResetType type)
+{
+    Esp32RmtState *s = ESP32_RMT(obj);
+    memset(s->registers, 0, sizeof(s->registers));
+    memset(s->memory, 0, sizeof(s->memory));
+    s->raw = 0;
+    s->enabled = 0;
+    s->error[0] = 0;
+    for (unsigned index = 0; index < 8; index++)
+    {
+        timer_del(s->channels[index].timer);
+        s->channels[index].active = false;
+        s->channels[index].position = 0;
+    }
+    for (unsigned index = 0; index < s->device_count; index++)
+    {
+        s->devices[index].frames = 0;
+        memset(s->devices[index].pixels, 0, sizeof(s->devices[index].pixels));
+    }
+    rmt_irq(s);
+}
+static void rmt_init(Object *obj)
+{
+    Esp32RmtState *s = ESP32_RMT(obj);
+    SysBusDevice *bus = SYS_BUS_DEVICE(obj);
+    memory_region_init_io(&s->iomem, obj, &rmt_ops, s, TYPE_ESP32_RMT, 0x1000);
+    sysbus_init_mmio(bus, &s->iomem);
+    sysbus_init_irq(bus, &s->irq);
+    for (unsigned index = 0; index < 8; index++)
+    {
+        s->channels[index].owner = s;
+        s->channels[index].index = index;
+        s->channels[index].timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, rmt_complete, &s->channels[index]);
+    }
+    object_property_add(obj, "ws2812-state", "str", rmt_get_pixels, NULL, NULL, NULL);
+    object_property_add(obj, "ws2812-config", "str", NULL, rmt_set_config, NULL, NULL);
+}
+static void rmt_class_init(ObjectClass *klass, void *data) { RESETTABLE_CLASS(klass)->phases.hold = rmt_reset; }
+static const TypeInfo rmt_info = {.name = TYPE_ESP32_RMT, .parent = TYPE_SYS_BUS_DEVICE, .instance_size = sizeof(Esp32RmtState), .instance_init = rmt_init, .class_init = rmt_class_init};
+static void rmt_register(void) { type_register_static(&rmt_info); }
+type_init(rmt_register)
