+static void esp32_rtcio_pull(Esp32GpioState *s, unsigned pin, uint32_t value, unsigned up, unsigned down)
+{
+    if (value & (1U << up))
+        s->gpio_pullup |= 1ULL << pin;
+    else
+        s->gpio_pullup &= ~(1ULL << pin);
+    if (value & (1U << down))
