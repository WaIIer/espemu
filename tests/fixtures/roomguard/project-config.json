{
  "v": 1,
  "starter": "empty",
  "language": "c",
  "manifest": {
    "v": 1,
    "target": "esp32",
    "buses": [{ "id": "i2c0", "type": "i2c", "controller": 0, "sda": 21, "scl": 22 }],
    "devices": [
      { "id": "climate", "type": "bme280", "bus": "i2c0", "address": 118 },
